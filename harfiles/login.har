y hủy nó sau khiđãđặt.</span>\",\"lbl_TabletSportOrder\":\"Thứ tự các môn thể thao\",\"lbl_teams\":\"Đội\",\"lbl_tennis\":\"Quần vợt\",\"lbl_Termandconditions\":\"Điều Khoản và Điều Kiện\",\"lbl_Termsofuse\":\"Điều khoản sử dụng\",\"lbl_tie\":\"Hòa\",\"lbl_time\":\"Giờ\",\"lbl_to\":\"Đến\",\"lbl_today\":\"Hôm Nay\",\"lbl_ToDesktop\":\"Phiên bản Máy tính để bàn\",\"lbl_total2\":\"Tổng cộng\",\"lbl_totalpoint_6\":\"Tổng Điểm\",\"lbl_totalset\":\"Tổng Set\",\"lbl_trac\":\"chuyển tiền\",\"lbl_tram\":\"chuyển tiền\",\"lbl_transfer\":\"Chuyển khoản\",\"lbl_transtime\":\"Thời Gian\",\"lbl_Trixie\":\"Trixie\",\"lbl_turnover\":\"Lượng tiền\",\"lbl_under\":\"Xỉu\",\"lbl_updateodds\":\"Chúng tôi đang cập nhật tỷ lệ cược, vui lòng thử lại sau.\",\"lbl_UserProfile_AutoRefresh\":\"Tự Động Làm Mới Phiếu Cược\",\"lbl_Virtual\":\"Ảo\",\"lbl_VirtualSport\":\"Thể Thao Ảo\",\"lbl_Void_Cancelled_Bet\":\"Cược bị vô hiệu hoá & hủy\",\"lbl_vr_Win\":\"Win\",\"lbl_vst_game\":\"Trò chơi\",\"lbl_win\":\"Thắng\",\"lbl_WinByPoint\":\"{0} thắng cách biệt {1} điểm\",\"lbl_WinByPoint_Plus\":\"{0} thắng cách biệt {1}+ điểm\",\"lbl_winlost\":\"Thắng / Thua\",\"lbl_won\":\"Thắng\",\"lbl_WorldCup\":\"Cúp Thế Giới\",\"lbl_yesterday\":\"Hôm Qua\",\"leagues\":\"Giải\",\"lessthanmin\":\"Tiền cược của bạn thấp hơn tiền cược tối thiểu.\",\"lic_availablefund\":\"Số tiền khả dụng\",\"lic_balance\":\"Số dư tài khoản\",\"lic_outstanding\":\"Tiền chờ xử lý\",\"lic_showbalance\":\"Hiển thị số dư tài khoản\",\"licensee_login\":\"Đăng nhập\",\"licensee_signup\":\"ĐĂNG KÝ\",\"livebetticketstatus1\":\"Trạng thái vé cược trực tuyến\",\"livebetticketstatus2\":\"Đang xử lý cược của bạn\",\"livebetticketstatus3\":\"Đã chấp nhận cược của bạn\",\"livebetticketstatus4\":\"Vui lòng kiểm tra Danh sách cược của bạn.\",\"LiveCasinoFlashMsg\":\"Tài khoản của bạn không thể đặt Casino Live game, vui lòng liên hệ cấp trên của bạn để được đặt cược.\",\"LiveMatch\":\"Trận đấu trực tiếp\",\"livescoreHeader_HT\":\"HT\",\"livescoreHeader_1H\":\"1H\",\"livescoreHeader_2H\":\"2H\",\"livescoreHeader_1P\":\"P1\",\"livescoreHeader_1Q\":\"Q1\",\"livescoreHeader_1S\":\"S1\",\"livescoreHeader_1stB\":\"Gôn 1\",\"livescoreHeader_2ndB\":\"Gôn 2\",\"livescoreHeader_2P\":\"P2\",\"livescoreHeader_2Q\":\"Q2\",\"livescoreHeader_2S\":\"S2\",\"livescoreHeader_3P\":\"P3\",\"livescoreHeader_3Q\":\"Q3\",\"livescoreHeader_3rdB\":\"Gôn 3\",\"livescoreHeader_3S\":\"S3\",\"livescoreHeader_4Q\":\"Q4\",\"livescoreHeader_4S\":\"S4\",\"livescoreHeader_5S\":\"S5\",\"livescoreHeader_N1H\":\"1H\",\"livescoreHeader_N2H\":\"2H\",\"livescoreHeader_Advantage\":\"Ưu điểm\",\"livescoreHeader_CurrentFrame\":\"Khung hiện tại\",\"livescoreHeader_Down\":\"Dưới\",\"livescoreHeader_EI\":\"EI\",\"livescoreHeader_Frames\":\"Frames\",\"livescoreHeader_injury\":\"Chấn thương\",\"livescoreHeader_OT\":\"OT\",\"livescoreHeader_Out\":\"Loại\",\"livescoreHeader_powerplay\":\"Power Play\",\"livescoreHeader_Pts\":\"Pts\",\"livescoreHeader_Serve\":\"Giao bóng\",\"livescoreHeader_Set\":\"Set\",\"livescoreHeader_T\":\"T\",\"livescoreHeader_TG\":\"TG\",\"livescoreHeader_TGames\":\"T.Games\",\"livescoreHeader_TieBreak\":\"TB\",\"livescoreHeader_ToGo\":\"To Go\",\"livescoreHeader_TPoints\":\"Tổng Điểm\",\"LiveStreaming\":\"Truyền hình trực tiếp\",\"livesupport\":\"Hỗ trợ Trực tiếp\",\"logout\":\"Đăng Xuất\",\"logoutinfo\":\"Bạn đã đăng nhập từ một cửa sổ trình duyệt hoặc thiết bị khác, bạn có muốn tiếp tục đăng nhập này không? Đăng nhập khác đó sẽ bị buộc đăng xuất.\",\"lose\":\"Thua\",\"Lucky3_1st\":\"1st\",\"Lucky3_1stPrize\":\"1st Prize\",\"Lucky3_2nd\":\"2nd\",\"Lucky3_2ndPrize\":\"2nd Prize\",\"Lucky3_3rd\":\"3rd\",\"Lucky3_3rdPrize\":\"3rd Prize\",\"Lucky3_coldNumber\":\"Cold<br>Number\",\"Lucky3_coldNumberTxt\":\"Cold Number\",\"Lucky3_guide\":\"Guide\",\"Lucky3_hotColdNumber\":\"Hot/Cold Number\",\"Lucky3_hotNumber\":\"Hot<br>Number\",\"Lucky3_hotNumberTxt\":\"Hot Number\",\"Lucky3_maxCap\":\"Max Cap\",\"Lucky3_No\":\"No.\",\"Lucky3_OR\":\"OR\",\"Lucky3_pickAtLeast3Numbers\":\"Pick At Least 3 Numbers\",\"Lucky3_PlayNow\":\"Play Now\",\"Lucky3_previousDraw\":\"Previous Draw\",\"Lucky3_quickPick\":\"Quick Pick\",\"Lucky3_setYourBets\":\"Set Your Bets\",\"Lucky3_setYourBetsDetail\":\"Place multi bets with the same numbers in these draws\",\"Lucky3_setYourDraws\":\"Set Your Draws\",\"Lucky3_setYourDrawsDetail\":\"Select the same numbers on these draws\",\"Lucky3_winningPrize\":\"Winning Prize\",\"Lucky3_winningShare\":\"Winning Share\",\"LVFAQA1\":\"Mỗi khi có truyền hình trực tuyến một trận đấu trực tiếp được chỉ định, biểu tượng tivi sẽ xuất hiện bên cạnh tên đội, chỉ cần nhấn vào biểu tượng tivi đó và bạn có thể bắt đầu xem trận đấu.\",\"LVFAQA2\":\"Bạn phải đặt cược tối thiểu cho trận đấu có cung cấp truyền hình trực tuyến. Việc kết hợp trận đấu vào Cược xiên KHÔNG phải là điều kiện đủ để nhận đặc quyền truyền hình trực tuyến.\",\"LVFAQA3\":\"Flash Player được cài đặt trên 98% máy tính có kết nối Internet trên toàn thế giới cũng trên rất nhiều loại thiết bị phổ biến.\",\"LVFAQA4\":\"Hãy truy cập Trung tâm Hỗ trợ Flash Player tại trang www.adobe.com. Bạn có thể truy cập khu vực xử lý sự cố để được hỗ trợ cài đặt tại:\",\"LVFAQA5\":\"Adobe cho phép thử nghiệm trực tuyến cho Flash Player\",\"LVFAQA51\":\"tại trang thử nghiệm web player của họ.\",\"LVFAQA6\":\"Flash Player có thể sử dụng trên hầu hết các nền tảng trình duyệt trong:\",\"LVFAQA7\":\"Để mang tới cho khách hàng trải nghiệm xem Flash gần như liền mạch, Adobe phân phối Flash Player thông qua nhiều đối tác quan trọng bao gồm:\",\"LVFAQA71\":\"Flash Player được cài đặt trước trong một số trình duyệt web và nhiều máy tính. Phần mềm này có trong các hệ điều hành WindowsR XP và Apple Macintosh.\",\"LVFAQA8\":\"Flash Player 8 và Flash Player 9 hỗ trợ rất nhiều nền tảng và trình duyệt, bao gồm cả những trình duyệt mới như Firefox và Safari.\",\"LVFAQA81\":\"Hiển thị yêu cầu hệ thống\",\"LVFAQQ1\":\"Tôi cần làm gì để xem truyền hình trực tuyến?\",\"LVFAQQ2\":\"Yêu cầu tối thiểu để xem truyền hình trực tuyến là gì?\",\"LVFAQQ3\":\"Tôi có thể lấy Flash Player ở đâu?\",\"LVFAQQ4\":\"Tôi gặp vấn đề khi cài đặt Flash Player. Tôi có thể nhận được hỗ trợ ở đâu?\",\"LVFAQQ5\":\"Tôi có thể thử nghiệm Flash Player ở đâu để đảm bảo phần mềm này hoạt động chính xác?\",\"LVFAQQ6\":\"Flash Player có thể sử dụng với những ngôn ngữ nào?\",\"LVFAQQ7\":\"Những trình duyệt và nền tảng nào hiện đang phân phối Flash Player?\",\"LVFAQQ8\":\"Yêu cầu hệ thống cho Flash Player 8 và Flash Player 9 là gì?\",\"Main_Markets\":\"Các trận đấu chính\",\"Maintenance_Message\":\"Hệ thống sắp thực hiện bảo trì. Chúng tôi rất xin lỗi vì sự bất tiện này.\",\"Malay_Odds\":\"Tỷ lệ cược MALAY\",\"match\":\"Trận đấu\",\"MatchInfo\":\"Trận đấu trực tiếp\",\"max\":\"Tối đa\",\"maxcsd\":\"MAX_CSD\",\"maxpayout\":\"Tiền thanh toán tối đa\",\"menu_1X2\":\"1X2\",\"menu_all\":\"Tất Cả\",\"menu_CS\":\"Tỷ Số Chính Xác\",\"menu_early\":\"Sớm\",\"menu_fav\":\"Yêu thích của tôi\",\"menu_FGLG\":\"Bàn thắng Đầu/ Cuối\",\"menu_GV\":\"Match Information List\",\"menu_HDPOU-Basketball\":\"Tất Cả\",\"menu_HDPOU1\":\"Tất Cả\",\"menu_HDPOU2\":\"Tất Cả\",\"menu_HDPOU3\":\"Tất Cả\",\"menu_HDPOU4\":\"Tất Cả\",\"menu_HDPOU5\":\"Tất Cả\",\"menu_HDPOU6\":\"Tất Cả\",\"menu_HDPOU-Volleyball\":\"Tất Cả\",\"menu_HTFT\":\"Hiệp 1/Toàn Trận\",\"menu_HTFTOE\":\"Chẵn / Lẻ của Nửa trận/Toàn trận\",\"menu_live\":\"Trực tiếp\",\"menu_livematch\":\"Trận đấu trực tiếp\",\"menu_livestreaming\":\"Truyền hình trực tiếp\",\"menu_m0\":\"Thể Thao\",\"menu_m1\":\"Thế Vận Hội\",\"menu_m2\":\"Vô Địch Thế Giới\",\"menu_m3\":\"Euro\",\"menu_m5\":\"Cúp Nam Mỹ\",\"menu_MP\":\"Cá Cược Tổng Hợp\",\"menu_OE\":\"Lẻ/Chẵn\",\"menu_OR\":\"Cược Thắng\",\"menu_parlay\":\"Cá Cược Tổng Hợp\",\"menu_s00\":\"Bóng đá\",\"menu_s10\":\"Tất Cả\",\"menu_s100\":\"Đua Ngựa\",\"menu_s110\":\"Bóng đá Ảo\",\"menu_s120\":\"Đua Ngựa Ảo\",\"menu_s130\":\"Đua Chó Ảo\",\"menu_s140\":\"Quần Vợt Ảo\",\"menu_s150\":\"Đua xe Ảo\",\"menu_s