r\":\"Bóng Đá Virtually\",\"lbl_VIP\":\"Bạn đã lên hạng Khách hàng chất lượng!\",\"lbl_VIPmsg\":\"Chúc mừng bạn đã trở thành thành viên Khách hàng chất lượng! Hãy tận hưởng các đặc quyền dành riêng cho bạn, và chúng tôi sẽ không ngừng cải tiến để mang đến những trải nghiệm ngày càng tuyệt vời hơn.\",\"lbl_VIPmsg1\":\"Cảm ơn bạn đã tin tưởng và ủng hộ!\",\"sport148\":\"Playtech\",\"lbl_TGames\":\"T.Games\",\"lbl_G1\":\"G1\",\"lbl_G2\":\"G2\",\"lbl_G3\":\"G3\",\"lbl_G4\":\"G4\",\"lbl_G5\":\"G5\",\"lbl_G6\":\"G6\",\"lbl_G7\":\"G7\",\"lbl_LuckyPrlyTooltip\":\"Xoay kết hợp cược xâu của bạn và nhận tăng cường tỷ lệ cược trên mỗi lần đặt cược. Đừng bỏ lỡ cơ hội thắng lớn của bạn!\",\"oddsTableTitle_ToWinSeries\":\"Đội Thắng Sau Loạt Trận\",\"oddsTableTitle_SeriesGamesHdp\":\"Cược Chấp Sau Loạt Trận\",\"oddsTableTitle_SeriesTotalGames\":\"Tổng Số Trận Sau Loạt Trận\",\"oddsTableTitle_SeriesCorrectScore\":\"Tỷ Số Chính Xác Sau Loạt Trận\",\"oddsTableTitle_SeriesLeaderAfterGame3\":\"Dẫn Trước Sau 3 Trận\",\"oddsTableTitle_SeriesLeaderAfterGame4\":\"Dẫn Trước Sau 4 Trận\",\"oddsTableTitle_SeriesCSAfterGame3\":\"Tỷ Số Chính Xác Sau Loạt 3 Trận\",\"oddsTableTitle_SeriesCSAfterGame4\":\"Tỷ Số Chính Xác Sau Loạt 4 Trận\",\"lbl_SeriesMatch\":\"Loạt Trận Đấu\",\"lbl_VIPmsg2\":\"Thông báo: Trạng thái Khách hàng chất lượng sẽ được đánh giá hàng tháng. Bắt đầu trải nghiệm độc quyền của bạn ngay bây giờ!\",\"lbl_GotIt\":\"Đã hiểu!\",\"lbl_RPGiveaway\":\"Cược không rủi ro (Quà tặng)\",\"sport145\":\"GPI\",\"sport144\":\"GPI Live Casino\",\"sport135\":\"Smartsoft\",\"sport198_header\":\"Đua Ngựa\",\"sport177_header\":\"Đua Chó\",\"sport198\":\"Đua Ngựa Ảo\",\"sport177\":\"Đua Chó Ảo\",\"menu_m4\":\"Thế Vận Hội Mùa Đông\",\"lbl_SabaAPIError\":\"Đã xảy ra lỗi khi sử dụng bộ tăng cường tỷ lệ cược, vui lòng liên hệ với dịch vụ khách hàng, xin cảm ơn.\",\"lbl_Ju_NewViewPopup02\":\"Kính gửi người dùng,<br/>\\nBắt đầu từ ngày 20 tháng 1 năm 2025, chúng tôi sẽ ngừng hỗ trợ phiên bản cũ:<br/>\\nTrình duyệt hiện tại của bạn có thể không phải là phiên bản mới nhất.<br/>\\nĐể đảm bảo trải nghiệm tốt hơn và dịch vụ mượt mà hơn, chúng tôi khuyến nghị bạn nâng cấp trình duyệt lên phiên bản mới nhất. Sử dụng trình duyệt cũ có thể khiến một số tính năng không hoạt động đúng cách hoặc hạn chế quyền truy cập dịch vụ.<br/>\\nCảm ơn sự thông cảm và hỗ trợ của bạn.\",\"lbl_BrowserUpgradeNotice3\":\"Phiên bản được hỗ trợ\",\"lbl_BrowserUpgradeNotice4\":\"Phiên bản Chrome 85 trở lên\",\"lbl_BrowserUpgradeNotice5\":\"Phiên bản Safari 13.4 trở lên\",\"lbl_BrowserUpgradeNotice9\":\"Opera phiên bản 77 trở lên\",\"lbl_Ju_NewViewPopup03\":\"Phiên bản Rút gọn và Galaxy mới\",\"lbl_Ju_NewViewPopup04\":\"Phiên bản Rút gọn nhanh và đơn giản, trong khi phiên bản Galaxy hiện đại và ngầu. Khám phá trải nghiệm đặt cược mới!\",\"lbl_Ju_NewViewPopup05\":\"1.Tương thích hoàn hảo với mọi thiết bị\",\"lbl_Ju_NewViewPopup06\":\"2.Đặt cược một chạm, hoàn tất ngay lập tức\",\"lbl_Ju_NewViewPopup07\":\"3.Chế độ và kiểu đặt cược độc quyền, chuyển đổi theo ý thích của bạn\",\"lbl_Ju_NewViewPopup08\":\"Trang chủ đã được nâng cấp, giúp cá cược thể thao tiện lợi hơn.\",\"lbl_Ju_NewViewPopup10\":\"Trải nghiệm giao diện website mới nhất\",\"lbl_Ju_NewViewPopup11\":\"Thử ngay\",\"lbl_BrowserUpgradeNotice6\":\"Phiên bản thiết bị cần được nâng cấp.\",\"lbl_BrowserUpgradeNotice7\":\"Quý khách hàng thân mến, để có trải nghiệm và dịch vụ tốt hơn, chúng tôi khuyên bạn nên nâng cấp \\\"trình duyệt\\\" hoặc \\\"hệ thống\\\" của mình lên phiên bản mới nhất trước khi tiếp tục sử dụng.\",\"lbl_BrowserUpgradeNotice8\":\"Chuyển sang phiên bản cũ\",\"lbl_Reward\":\"tiền thưởng\",\"lbl_RewardMsg\":\"Xin chúc mừng bạn đã nhận được phần thưởng từ công ty! Hãy nhớ nhận phần thưởng từ cấp trên của bạn.\",\"lbl_RewardChecked\":\"Bạn có thể kiểm tra tiền thưởng đã phân phối trong phần \\\"sao kê\\\". Nếu bạn chưa nhận được tiền, vui lòng gửi phản hồi đến cấp trên qua \\\"sao kê\\\".\",\"lbl_RewardPopUp\":\"Chúc mừng! Bạn đã nhận được tiền thưởng từ công ty. Nhấn OK ngay bây giờ để tìm hiểu thêm về cách nhận thưởng của bạn.\",\"lbl_RewardPress1\":\"Khi nhấn \\\"Có\\\", bạn xác nhận rằng đã nhận được tiền thưởng, sau đó, mọi yêu cầu về việc <font color=\\\"red\\\">CHƯA NHẬN tiền thưởng</font> sẽ không được chấp nhận.\",\"lbl_RewardReceived\":\"Bạn có chắc chắn rằng mình <font color=\\\"red\\\">ĐÃ NHẬN</font> tiền thưởng?\",\"lbl_RewardPress2\":\"Khi nhấn \\\"Có\\\", phản hồi của bạn sẽ được gửi ngay tới cấp trên. Vui lòng liên hệ với cấp trên để sắp xếp nhận tiền thưởng.\",\"lbl_RewardNotReceived\":\"Bạn có chắc chắn rằng mình <font color=\\\"red\\\">CHƯA NHẬN</font> được tiền thưởng không?\",\"lbl_HowToUse1\":\"Tiền thưởng do công ty trao tặng. Các Member có thể nhận thêm tiền thưởng khi tham gia các sự kiện khác, và mỗi phần thưởng sẽ do cấp trên phân phối.\",\"lbl_HowToUseLocation1\":\"Khi nhận được tiền thưởng, bạn có thể kiểm tra số tiền trong Thông tin Tài khoản.\",\"lbl_HowToUseLocation2\":\"Bạn có thể kiểm tra các khoản tiền thưởng đã được phân phối trong sao kê của mình.\",\"lbl_RewardOK\":\"OK\",\"livescoreHeader_G4\":\"G4\",\"livescoreHeader_G5\":\"G5\",\"livescoreHeader_G6\":\"G6\",\"livescoreHeader_G7\":\"G7\",\"lbl_VGA0002\":\"Sảnh Vgaming Mobi\",\"lbl_VGA0004\":\"Sảnh Vgaming Keno\",\"lbl_SBC13210\":\"BaccaratX\",\"lbl_VGA13503\":\"BaccaratX\",\"lbl_Baseball_Inning\":\"Hiệp {0}\",\"lbl_TermsAndPolicy\":\"Điều khoản và Chính sách\",\"lbl_AMLPolicy\":\"Chính sách chống rửa tiền\",\"lbl_PlayerFundsPolicy\":\"Chính sách quỹ của người chơi\",\"lbl_ResponsibleGamingPolicy\":\"Chính sách chơi game có trách nhiệm\",\"lbl_ComplaintsAndArbitration\":\"Khiếu nại và Trọng tài\",\"lbl_WhatIsReward\":\"Phần thưởng là gì?\",\"lbl_OurPolicy\":\"Chính sách của chúng tôi:\",\"lbl_Termandconditions2\":\"Điều Khoản và Điều Kiện\",\"lbl_Termsofuse2\":\"Điều khoản sử dụng\",\"lbl_PrivacyPolicy2\":\"Chính sách bảo mật\",\"AboutUs2\":\"Giới thiệu về chúng tôi\",\"lbl_VivaSportsBot\":\"Viva Sport