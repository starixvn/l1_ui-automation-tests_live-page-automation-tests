ogineMsg\":\"বাজিগুলি ধরতে অনুগ্রহ করে সাইন আপ অথবা লগইন করুন।\",\"Msg\":\"বার্তা\",\"lbl_deposit\":\"কোনো বাজি ধরার জন্য আপনার পর্যাপ্ত ফান্ড নেই।\",\"lbl_StreamingError\":\"ওহ! কিছু ভুল হয়েছে।\",\"lbl_3rdPartyErrMsg\":\"একটি ত্রুটি হয়েছে। বিস্তারিত জানার জন্য অনুগ্রহ করে CSD-এর সাথে যোগাযোগ করুন, ধন্যবাদ।\",\"lbl_Back\":\"ফিরে যান\",\"lbl_Disclaimer\":\"সব লাইভ সম্প্রচার, সদস্যদের শুধুমাত্র রেফারেন্স দেখার জন্য দেওয়া হয়। কোম্পানি নির্ভুল ডেটা প্রদান করার চেষ্টা করে; তবে, ডেটা ভুল বা ত্রুটি মুক্ত, বাদ গেছে বা সম্ভাব্য বাধা মুক্ত হবে এমন নিশ্চয়তা দেয় না। সদস্যদের অত্যন্ত সতর্কতার সাথে ডেটা ব্যবহার করতে হবে এবং এটি ব্যাখ্যা করার সময় যথাযথ বিচার বিবেচনা করে নিতে হবে। এই ধরনের ভুলের ক্ষেত্রে, কোম্পানি কোন ক্ষয় বা ক্ষতির (প্রত্যক্ষ বা পরোক্ষ) দায় নেয় না।\",\"lbl_live\":\"লাইভ\",\"lbl_Upcoming\":\"আসন্ন\",\"NoGame\":\"এই মুহূর্তে কোনো গেম উপলব্ধ নেই।\",\"lbl_ReachBottom\":\"পেজের নীচে পৌঁছেছে\",\"lbl_FTHDP\":\"FT. HDP\",\"lbl_FTOE\":\"FT. O/E\",\"lbl_FTOU\":\"FT. O/U\",\"lbl_FT1X2\":\"FT. 1X2\",\"lbl_moneyline\":\"মানিলাইন\",\"lbl_home\":\"ঘরের মাঠে\",\"lbl_away\":\"বাইরে\",\"lbl_odd\":\"অড\",\"lbl_even\":\"ইভেন\",\"lbl_over\":\"ওভার\",\"lbl_under\":\"নিচে\",\"lbl_1x2_Home\":\"ঘরের মাঠে\",\"lbl_draw\":\"ড্র\",\"lbl_1x2_Away\":\"বাইরে\",\"lbl_odds_o\":\"O\",\"lbl_odds_u\":\"U\",\"b401\":\"Home Team Over/Under\",\"b402\":\"Away Team Over/Under\"}')},36295:function(e){\"use strict\";e.exports=\"data:image/png;base64,\"},36361:function(e,t,n){\"use strict\";Object.defineProperty(t,\"__esModule\",{value:!0});var r=n(60771),i=n(82026),a=\"function\"==typeof ArrayBuffer,o=function(e,t){if(a){var n=(0,i.decode)(e);return s(n,t)}return{base64:!0,data:e}},s=function(e,t){return\"blob\"===t&&e instanceof ArrayBuffer?new Blob([e]):e};t.default=function(e,t){if(\"string\"!=typeof e)return{type:\"message\",data:s(e,t)};var n=e.charAt(0);return\"b\"===n?{type:\"message\",data:o(e.substring(1),t)}:r.PACKET_TYPES_REVERSE[n]?e.length>1?{type:r.PACKET_TYPES_REVERSE[n],data:e.substring(