l_EuroCupLB\":\"Thắng lớn cùng Cúp Euro 2020 và Cúp Nam Mỹ 2021\\nSaba Sports Tặng Đến 12 Điểm Cho Tất Cả Các Trận\",\"lbl_EuroCupOB\":\"Cường Hóa Tỷ Lệ Cược\",\"lbl_EuroCupXpt\":\"{0} point(s)\",\"lbl_EuroCupCD\":\"Xem chi tiết \",\"lbl_EuroCupLeft\":\"Thắng lớn cùng Cúp Euro 2020 và Cúp Nam Mỹ 2021\\n12 Điểm Cho Tất Cả Các Trận\",\"lbl_EuroCupPI\":\"Thông Tin Chương Trình Khuyến Mãi\",\"lbl_EuroCupPD\":\"Ngày Chương Trình Khuyến Mãi\",\"lbl_EuroCupEY\":\"Điều Kiện\",\"lbl_EuroCupTPO\":\"Chỉ thành viên trên trang Tiền Mặt được phép tham gia chương trình khuyến mãi này.\",\"lbl_EuroCupSS\":\"Môn Thể Thao Được Hỗ Trợ\",\"lbl_EuroCupSALS\":\"Hỗ trợ tất cả các Giải Đấu Bóng Đá Trực Tiếp trừ Bóng Đá Saba và PinGoal Bóng Đá Saba.\",\"lbl_EuroCupIOOB\":\"Giới thiệu chương trình Tăng Tỷ Lệ Cược\",\"lbl_EuroCupWOB\":\"[Tăng Tỷ Lệ Cược] là gì?\",\"lbl_EuroCupROB\":\"Tỷ lệ cược từ Saba Sports được tăng ngẫu nhiên, cho người chơi tỷ lệ cược tốt nhất của kèo.\",\"lbl_EuroCupHOB\":\"Cách Nhận [Tăng Tỷ Lệ Cược]?\",\"lbl_EuroCupCLHO\":\"Chọn Chấp trực tiếp và Tài/Xỉu trong mục Bóng Đá. Saba Sports sẽ tăng tỷ lệ cược ngẫu nhiên.\",\"lbl_EuroCupHUse\":\"Cách Sử Dụng [Tăng Tỷ Lệ Cược]?\",\"lbl_EuroCupGOP\":\"Cơ hội vàng！ Chỉ cần đặt cược là được tăng tiền trả thưởng.\",\"lbl_EuroCupQuickbet\":\"Bet now\",\"lbl_EuroCupOffers\":\"Giảm giá\",\"lbl_EuroCupRRLa\":\"Chương trình khuyến mãi Tăng Tỷ Lệ Cược THỂ THAO SABA dành cho người chơi Saba Sports theo quyết định của công ty trong thời gian diễn ra chương trình khuyến mãi.\",\"lbl_EuroCupRRLb\":\"Toàn bộ thành viên SABA SPORTS đều đủ điều kiện tham gia chương trình khuyến mãi.\",\"lbl_EuroCupRRLc\":\"12 điểm thưởng của chương trình này được tính \\\"theo\\\" dạng tỷ lệ cược Trung Quốc. Mọi dạng tỷ lệ cược khác sẽ tự động được tính theo cùng số điểm.\",\"lbl_EuroCupRRLd\":\"SABA SPORTS có quyền bảo lưu toàn quyền chấm dứt Chương Trình Khuyến Mãi Tăng Tỷ Lệ Cược SABA SPORTS và thay đổi, hạn chế, sửa đổi hoặc thêm quy tắc, quy định, điều khoản và điều kiện của SABA SPORTS, vào bất cứ thời điểm nào mà không cần thông báo trước.\",\"lbl_EuroCupRRLe\":\"SABA SPORTS bảo lưu quyền chấm dứt và/hoặc vô hiệu ưu đãi thành viên của các thành viên đã được cấp, nhận hoặc đổi thưởng do lỗi của máy tính, gian lận hoặc trộm cắp, và/hoặc bằng các phương cách bất hợp pháp hoặc theo cách thức không được cho phép trong các quy định và quy tắc chính thức và các điều khoản và điều kiện của chương trình khuyến mãi Tăng Tỷ Lệ Cược SABA SPORTS.\",\"lbl_EuroCupRRLf\":\"Bằng cách đăng ký tham gia chương trình khuyến mãi, thành viên đồng ý chịu ràng buộc theo các điều khoản và điều kiện này. Các quy định liên quan đến chương trình khuyến mãi Tăng Tỷ Lệ Cược SABA SPORTS cũng như các ưu đãi đặc biệt và hoàn tiền khác nhau có thể thay đổi mà không thông báo trước.\",\"sport172\":\"AdvantPlay\",\"lbl_Soccer5\":\"Soccer 5\",\"lbl_LiveOnly\":\"Trực tiếp\",\"lbl_BbinErr_1015\":\"Hoạt động giao dịch trước đó vẫn chưa hoàn thành. Vui lòng thử lại sau 10 giây.\",\"sport234\":\"Joker\",\"sport238\":\"Habanero\",\"lbl_MoreDates\":\"Ngày khác\",\"lbl_More\":\"Xem thêm\",\"lbl_Less\":\"Thu gọn\",\"lbl_WLReport\":\"Báo cáo Thắng/Thua\",\"lbl_NoTkts\":\"Tổng số Vé cược\",\"lbl_LaWkTtl\":\"Tổng Tuần trước\",\"lbl_ThWkTtl\":\"Tổng Tuần này\",\"lbl_MoreVideo\":\"Video khác \",\"lbl_CollapseEvntList\":\"Thu gọn Danh sách Sự kiện \",\"lbl_ExpandEvntList\":\"Mở rộng Danh sách Sự kiện \",\"esport_gametype_ESportsLottery\":\"Xổ Số Thể Thao Điện Tử\",\"lbl_HeroPrfl\":\"Hồ Sơ Tướng\",\"lbl_CashOutUpdating\":\"Updating cash out odds\",\"sport175\":\"Bitcoin\",\"bettype7901\":\"Tài/Xỉu Bitcoin\",\"lbl_BTCOfferSoonMsg\":\"Hiện không có kèo nào. Kèo mới sẽ sớm được đưa ra.\",\"lbl_BTCSettleTime\":\"Thời Điểm Quyết Toán Giá\",\"lbl_BTCResultPrice\":\"Giá Kết Quả\",\"pattern_bet_bettype9607\":\"Số Bào vị Vòng {@Over} của Đội nhà\",\"pattern_bet_bettype9608\":\"Số Bào vị Vòng {@Over} của Đội khách\",\"pattern_bet_bettype9609\":\"Số Bào vị ở Lượt đánh 1 Vòng {