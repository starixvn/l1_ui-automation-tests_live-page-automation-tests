olor2\":\"Mang đến cho bạn nhiều lựa chọn màu sắc để tạo ra một phong cách độc đáo cho bạn.\",\"lbl_Theme\":\"Màu sắc chủ đề\",\"lbl_Classic\":\"Cổ điển\",\"lbl_Modern\":\"Hiện đại\",\"lbl_TG_Popular_Mk\":\"Nâng cấp chức năng! Đặt cược trên các thị trường bóng đá phổ biến trong ứng dụng.\",\"lbl_MyFev_Rul1\":\"Giới hạn theo dõi đội yêu thích là {0}。\",\"lbl_Warning\":\"Cảnh báo\",\"lbl_MyFev_Rul2\":\"Đội bạn đã thêm vào danh sách ưa thích của tôi đã đạt đến giới hạn ({0})。\",\"lbl_MyFev_Rul3\":\"Hủy theo dõi tất cả\",\"sport227\":\"Live22\",\"sport216\":\"UU SLOTS\",\"esport_gametype_97\":\"E-Sports Virtual\",\"lbl_IPID_Copied\":\"Đã sao chép ID và IP vào bảng ghi tạm\",\"lbl_Copied_Button\":\"Sao chép\",\"lbl_OnlySupportDec\":\"Hiện tại, chỉ hỗ trợ tỷ lệ cược thập phân cho parlay.\",\"lbl_statusChange\":\"Trạng thái đã thay đổi.\",\"lbl_DontSupportParlay\":\"Parlay không được cung cấp cho loại cược này.\",\"lbl_TotalProfit\":\"Tổng lợi nhuận\",\"lbl_TotalLiability\":\"Tổng Nghĩa vụ\",\"lbl_BetSetting\":\"Cài đặt cược\",\"lbl_SaveAgain\":\"Rủi ro！ Vui lòng lưu lại.\",\"lbl_PartUnsucBet\":\"Cược cho {0} vé không thành công. Nó đã được đặt chỗ cho bạn trong tờ cược.\",\"lbl_OddsTypeMin1\":\"Dec\",\"lbl_OddsTypeMin2\":\"HK\",\"lbl_OddsTypeMin3\":\"Indo\",\"lbl_OddsTypeMin4\":\"MY\",\"lbl_OddsTypeMin5\":\"US\",\"lbl_OddsTypeMin6\":\"MMR\",\"China_Odds_Min\":\"CN\",\"lbl_ParlayOddsError\":\"Các tùy chọn tỷ lệ Parlay không được dành cho cùng một trận đấu.\",\"lbl_RPReward8\":\"Vua Vô Song\",\"lbl_RPReward9\":\"Vua Huyền Thoại\",\"lbl_RPGalaxyTO\":\"Khám phá trải nghiệm cá cược Galaxy\",\"lbl_RPGalaxyFeedback\":\"Phản hồi về trải nghiệm Galaxy\",\"lbl_RPDailycheckin2\":\"Đăng nhập hàng ngày để nhận SABA Xu miễn phí.\",\"lbl_RPMemberBenefits\":\"Lợi ích dành cho thành viên\",\"lbl_RPRules2\":\"Quy định về giảm trừ lỗ ròng trong tất cả các môn thể thao\",\"lbl_RPApplicable2\":\"Môn thể thao áp dụng: Tất cả môn thể thao\",\"lbl_RPGetSabaCoins\":\"Nhận SABA Xu hàng ngày\",\"lbl_RPRules3\":\"Quy định của chương trình SABA Xu Bất ngờ Hàng ngày\",\"lbl_RPCoinsRules1\":\"SABA Sports trao các bậc phần thưởng đăng nhập khác nhau dựa trên mức thưởng của thành viên\",\"lbl_RPCoinsRules2\":\"Chắc chắn nhận thưởng khi đăng nhập hàng ngày và sẽ ngẫu nhiên nhận được SABA xu\",\"lbl_RPCoinsRules3\":\"Bạn đăng nhập càng nhiều ngày liên tiếp trong tuần thì số xu SABA ngẫu nhiên bạn có thể nhận được càng cao\",\"lbl_RPCoinsRules4\":\"Khi đạt mức thưởng Vàng, vào ngày đăng nhập thứ bảy liên tiếp, bạn sẽ được tặng thêm phiếu thưởng SABA\",\"lbl_RPWeeklyVoucher\":\"Phiếu thưởng miễn phí hàng tuần\",\"lbl_RPRules4\":\"Quy định về tặng quà người chơi danh dự hàng tuần\",\"lbl_RPFreeVoucherDetail1\":\"Khi đạt mức thưởng Hồng Ngọc, môn Thể thao SABA tặng thêm phiếu thưởng SABA\",\"lbl_RPFreeVoucherDetail2\":\"Tặng phiếu thưởng trước 23:59 Thứ Hai hàng tuần (GMT-4)\",\"lbl_RPUnlock\":\"Đã mở khóa cấp độ mới\",\"lbl_CurrentLevel\":\"Cấp độ hiện tại\",\"lbl_RPFeedbackOnce\":\"Đã điền vào bản khảo sát một lần\",\"lbl_RPGo1\":\"Đi\",\"lbl_RPAccquireGalaxyTO\":\"Nhận Điểm phần thưởng của bạn bằng cách đạt doanh thu cụ thể tại Galaxy trước 23:59 Chủ Nhật hàng tuần (GMT-4)\",\"lbl_RPAccumulatedGalaxy\":\"Phương pháp tích lũy: Tổng doanh thu của toàn bộ sản phẩm thể thao tại Galaxy\",\"lbl_RPAccquireQuestionnaire\":\"Nhận Điểm phần thưởng của bạn bằng cách hoàn thành cuộc khảo sát cho Galaxy\",\"lbl_RPAccumulatedQuestionnaire\":\"Phương thức mua lại: Điền và gửi bản khảo sát Galaxy Edition\",\"lbl_RPMemberR9\":\"Thời gian tính toán số SABA xu lỗ ròng cho chương trình phần thưởng SABA dựa trên chu kỳ hàng tuần từ 00:00 thứ Hai đến 23:59 Chủ nhật (GMT-4).\",\"lbl_RPMemberR10\":\"Thời gian tính toán nhiệm vụ cho Thứ hạng SABA trong khuôn khổ chương trình Phần thưởng SABA dựa trên chu kỳ hàng tuần, bắt đầu từ 00:00 Thứ Hai (GMT-4), với tổng số Điểm phần thưởng trong chương trình khen thưởng làm tiêu chí xếp hạng.\",\"lbl_RPMemberR11\":\"Sau khi đổi quà hoặc trao đổi phiếu thưởng, nó chỉ có thể sử dụng cho sản phẩm SABA của SABA Sports và phải được sử dụng trong vòng một tháng. Nếu không, nó sẽ tự động hết hạn.\",\"lbl_RPMemberR12\":\"Khi thành viên đạt cấp Kim cương trở lên, thành viên cần tích lũy kinh nghiệm cụ thể mỗi tuần để tiếp tục tận hưởng các lợi ích từ cấp Kim cương trở lên.\",\"lbl_RPMemberR13\":\"Nhiệm vụ đăng ký hàng ngày trong chương trình SABA sẽ nhận được SABA xu dựa trên quyết định của hệ thống. Mỗi lần rút tiền hàng ngày sẽ được cung cấp SABA xu theo các mức phần thưởng khác nhau.\",\"lbl_RPMemberR14\":\"Việc giảm giá cho SABA xu và phiếu thưởng được thực hiện vào thứ Hai hàng tuần lúc 00:00 (GMT-4) và sẽ được phân phối trong vòng 24 giờ.\",\"lbl_RPMemberR15\":\"Thành viên sẽ kiếm được phần thưởng SABA xu dựa trên loại hình thể thao và phạm vi danh hiệu phần thưởng của thành viên.\",\"lbl_RPMemberR16\":\"Đơn vị giảm giá sẽ là SABA xu. Bị hạn chế chỉ mua hàng trong Cửa hàng SABA hoặc chuyển đổi thành tiền mặt.\",\"lbl_RPMemberR17\":\"Số đồng xu SABA không được nhận sẽ bị xóa sau thời hạn.\",\"lbl_RPRR9\":\"Lỗ ròng là tổng tiền lãi hàng tuần của thành viên trừ đi tổng số tiền đặt cược. Nếu tổng số tiền đặt cược lớn hơn tổng số tiền lãi thì sẽ bị lỗ ròng. Các ván cược được đặt và thanh toán trong cùng một tuần sẽ được đưa vào cùng một lần tính. Chỉ các ván cược đặt trong Cá cược thể thao (bao gồm SABA Thể thao điện tử , SABA Ảo ) mới đủ điều kiện được hoàn tiền mặt. Cash Out (Rút tiền cược sớm) không được tính vào chương trình khuyến mãi này.\",\"lbl_RPRR10\":\"Nếu chương trình gặp trục trặc về kỹ thuật, phần thưởng giảm giá sẽ tiếp tục tích lũy và sẽ được áp dụng cho tài khoản của thành viên sau khi chương trình hoạt động trở lại.\",\"lbl_RPRR11\":\"SABA có quyền tuyệt đối chấm dứt chương trình SABA và thay đổi, giới hạn, sửa đổi hoặc thêm vào chương trình SABA, các quy tắc, quy định, điều khoản và điều kiện bất cứ lúc nào mà không cần thông báo trước. Chúng bao gồm nhưng không giới hạn ở việc áp đặt giới hạn thời gian và thay đổi về giảm giá tiền mặt, phần thưởng và mức thưởng.\",\"lbl_RPRR12\":\"SABA có quyền bán bất kỳ phiếu thưởng nào trong Cửa hàng SABA.\",\"lbl_RPSabaCoins\":\"SABA Xu\",\"lbl_RPBrandNew\":\"Phần thưởng hoàn toàn mới, cửa hàng SABA độc quyền\",\"lbl_RPTotal\":\"Tổng\",\"lbl_RPSabaRank\":\"Xếp hạng SABA\",\"lbl_RPExclusiveVIPReward\":\"Phần thưởng VIP độc quyền\",\"lbl_RPRewardsOfWeek\":\"Phần thưởng tuần\",\"lbl_RPAccquireRank\":\"Hệ thống sẽ phân phối phần thưởng trong vòng 24 giờ sau khi tính toán vào lúc 23:59 (GMT-7) Chủ Nhật hàng tuần\",\"lbl_RPRankTop4\":\"Top 4\",\"lbl_RPRankTop5\":\"Top 5\",\"lbl_RPRankTop6\":\"Top 6\",\"lbl_RPRankTop10\":\"Top 10\",\"lbl_RPSabaShop\":\"Cửa hàng SABA\",\"lbl_RPExclusiveShop\":\"Cửa hàng dành riêng cho bạn\",\"lbl_RPCheckIn\":\"Đăng nhập\",\"lbl_RPRedeemVoucher\":\"Đổi phiếu thưởng lấy quà\",\"lbl_RPWeeklyLimit\":\"Giới hạn hàng tuần\",\"lbl_RPRiskFreeBet\":\"Đặt cược không rủi ro\",\"lbl_RPOddsBooster\":\"Tăng tỷ lệ cược\",\"lbl_RPExchangeCashBack\":\"Đổi trả lại tiền mặt\",\"lbl_RPRedeem\":\"Đổi lấy quà\",\"lbl_RPExchange\":\"Trao đổi\",\"lbl_RPSoldOutPercentage\":\"Đã bán {X}%\",\"lbl_RPSoldOut\":\"Đã bán hết\",\"lbl_RPRiskFreeBetRule\":\"Đặt cược không rủi ro! SABA luôn sát cánh bên bạn!\",\"lbl_RPOddsBoosterRule\":\"Nhận phần thưởng lớn nhờ phiếu thưởng!\",\"lbl_RPExchangeCashRule\":\"Đổi SABA xu lấy tiền mặt!\",\"lbl_RPUnlockVoucher\":\"Mở khóa tính năng đổi phiếu thưởng bằng cách đạt {X}\",\"lbl_RPTask\":\"Nhiệm vụ\",\"lbl_RPVoucherDetails\":\"Chi tiết phiếu thưởng\",\"lbl_RPOddsBoosterDetails\":\"Tăng tỷ lệ ván cược đơn lên 1 điểm (Dựa trên loại tỷ lệ cược Mã Lai)\",\"lbl_RPRiskFreeDetails\":\"Nếu ván cược đơn thua, chúng tôi sẽ hoàn  {X} tiền cho bạn\",\"lbl_RPCashBackDetails\":\"SABA xu có thể được đổi lấy {X} và bạn có thể kiểm tra bảng sao kê sau\",\"lbl_RPUsageRules\":\"Quy tắc sử dụng\",\"lbl_RPVoucherRules1\":\"Phải được sử dụng trong vòng một tháng sau khi đổi quà\",\"lbl_RPVoucherRules2\":\"Chỉ dành cho bóng đá và bóng rổ\",\"lbl_RPVoucherRules3\":\"Loại cược: Chấp toàn trận / Chấp nửa trận đầu / Toàn trận. Tài/Xỉu/Nửa trận đầu. Tài/Xỉu\",\"lbl_RPVoucherRules4\":\"Không thể áp dụng phiếu thưởng nếu cược theo loại tỷ lệ cược Myanmar\",\"lbl_RPVoucherRules5\":\"Không thể rút tiền cược sớm từ vé sau khi đặt cược bằng phiếu thưởng\",\"lbl_RPVoucherRules6\":\"Chỉ áp dụng cho cược đơn, không hỗ trợ cho cược nhiều lần\",\"lbl_RPVoucherRules7\":\"Phiếu thưởng chỉ dùng một lần, không được chọn nhiều lần\",\"lbl_RPVoucherRules8\":\"Phiếu thưởng được đổi sớm nhất sẽ được sử dụng trước, người chơi không thể chọn phiếu thưởng cụ thể\",\"lbl_RPVoucherRules9\":\"SABA Sport có quyền đưa ra diễn giải cuối cùng đối với tất cả các phiếu thưởng\",\"lbl_RPUnlockAt\":\"Mở khóa lúc {X}\",\"lbl_RPConfirmRedeem\":\"Xác nhận đổi\",\"lbl_RPNoSabaCoins\":\"Không đủ SABA xu\",\"lbl_RPVoucherSoldOut\":\"Phiếu thưởng đã được bán hết\",\"lbl_RPLimitReached\":\"Đã đạt giới hạn đổi quà\",\"lbl_RPInsufficientLevel\":\"Cấp độ không đủ\",\"lbl_RPRedeemSuccess\":\"Đổi quà thành công\",\"lbl_RPMyVoucher\":\"Phiếu thưởng của Tôi\",\"lbl_RPNoVoucher\":\"Không có phiếu thưởng nào có sẵn. Hãy đổi quà ngay bây giờ!\",\"lbl_RPExpireSoon\":\"Sắp hết hạn\",\"lbl_RPMaxSubsidy\":\"Trợ cấp tối đa {X}\",\"lbl_RPGoToUse\":\"Đi\",\"lbl_RPVoucherRecords\":\"Lịch sử phiếu thưởng\",\"lbl_RPObtained\":\"Đã thu được\",\"lbl_RPUsed\":\"Đã sử dụng\",\"lbl_RPNoAcquisitionRecords\":\"Bạn hiện không có bất kỳ lịch sử nhận phiếu thưởng  nào\",\"lbl_RPNoUsageRecords\":\"Bạn hiện không có bất kỳ lịch sử sử dụng phiếu thưởng nào\",\"lbl_RPRankRewards\":\"Phần thưởng xếp hạng\",\"lbl_RPCheckInCompleted\":\"Đã hoàn thành phần thưởng đăng nhập hàng ngày\",\"lbl_RPSabaShopRedeem\":\"Đổi quà tại cửa hàng SABA\",\"lbl_RPUtilizedVoucher\":\"Phiếu thưởng đã sử dụng\",\"lbl_RPDoNotUse\":\"Không sử dụng\",\"lbl_RPSelectedOddsBooster\":\"Tăng tỷ lệ cược đã chọn\",\"lbl_RPSelectedRiskFreeBet\":\"Cược Không Rủi Ro đã chọn\",\"lbl_RPCanceledVoucher\":\"Đã hủy việc sử dụng phiếu thưởng\",\"lbl_RPVoucherExpired\":\"Phiếu thưởng đã hết hạn\",\"lbl_RPRecords30Day\":\"Chỉ hiển thị hồ sơ trong 30 ngày qua\",\"lbl_RPSabaCoinsRecords\":\"Lịch sử của SABA xu\",\"lbl_RPNoSabaCoinsRecords\":\"Bạn không có bất kỳ lịch sử nào của SABA xu\",\"lbl_RPRedeemFreeBet\":\"Đổi cược không có rủi ro\",\"lbl_RPRedeemBooster\":\"Đổi tăng tỷ lệ cược\",\"lbl_RPCashExchange\":\"Đổi tiền mặt\",\"lbl_RPNetLossRebate\":\"Hoàn tiền lỗ ròng hàng tuần\",\"lbl_RPWinning\":\"Chiến thắng!\",\"lbl_RPClickEarnCoins\":\"Nhấp vào để kiếm xu\",\"lbl_RPCongrats\":\"Xin chúc mừng\",\"lbl_RPCheckInForDays\":\"Đã đăng nhập được {X} ngày\",\"lbl_RPCheckInFor7Days\":\"Đăng nhập liên tục 7 ngày để nhận quà\",\"lbl_RPResetAccumulation\":\"Đặt lại tích lũy vào Thứ Hai hàng tuần lúc 00:00 (GMT-4)\",\"lbl_RPPlaceBet\":\"Đặt cược\",\"lbl_RPTodayCompleted\":\"Đã hoàn thành lần đăng nhập ngày hôm nay\",\"lbl_RPRank\":\"Xếp hạng\",\"lbl_RPGoSabaShop\":\"Đến cửa hàng SABA\",\"lbl_RPGainBenefits\":\"Lợi ích thu được\",\"lbl_RPCheckBenefits\":\"Kiểm tra các lợi ích đầy đủ\",\"lbl_RPNoMultipleBets\":\"Không được phép sử dụng phiếu thưởng để đặt cược nhiều lần.\",\"lbl_RPPampersYou\":\"SABA Sports chiều lòng bạn\",\"lbl_RPNewSabaReward\":\"Hệ thống phần thưởng SABA mới\",\"lbl_RPUpgrade\":\"Nâng cấp mức thưởng và đăng nhập hàng ngày\",\"lbl_RPBrandNewDebut\":\"Hoàn toàn mới\",\"lbl_RPEarnSabaCoins\":\"Kiếm SABA Xu\",\"lbl_RPExploreSabaShop\":\"Khám phá Cửa hàng SABA\",\"lbl_RPDiverseVouchers\":\"Phiếu thưởng đa dạng, cược không giới hạn!\",\"lbl_RPBeRelieved\":\"Yên tâm hơn khi đặt cược không rủi ro\",\"lbl_RPUpgradeBetting\":\"Cá cược được nâng cấp với tỷ lệ cược đặc biệt\",\"lbl_RPTop10OnRankings\":\"Top 10 người chơi trên bảng xếp hạng kinh nghiệm\",\"lbl_RPSpecialVouchersWeekly\":\"Sẽ được hưởng <span class='reward-new-version-rank__text-highlight'>phiếu thưởng đặc biệt</span> hàng tuần\",\"lbl_RPObtainSabaCoins\":\"Làm cách nào để nhận được SABA Xu?\",\"lbl_RPCheckInEveryday1\":\"1. Đăng nhập hàng ngày, SABA xu được trao mỗi ngày\",\"lbl_RPCheckInEveryday2\":\"Thăng cấp khi hoàn thành nhiệm vụ và nhận thêm phiếu thưởng hàng tuần\",\"lbl_RPBettingSubsidy1\":\"2. Trợ cấp cá cược, hoàn tiền hàng tuần bằng SABA xu\",\"lbl_RPBettingSubsidy2\":\"Hoàn tiền bằng SABA xu cho các khoản lỗ ròng hàng tuần\",\"lbl_RPRebateExample1\":\"Lấy <div class='reward-new-version-example__badge'> <div class='reward-badge-level' data-level='2' data-highlight='true'> <div class='reward-badge -level__img'></div> </div> Vàng </div> ví dụ về khoản hoàn tiền lỗ ròng của người dùng:\",\"lbl_RPRebateExample2\":\"Số tiền hoàn cho lỗ ròng\",\"lbl_RPRebateExample3\":\"<strong>1.000</strong><span>({0})</span><span> x </span><strong>{1}%</strong><span>hoàn tiền</span>\",\"lbl_RPRebateExample4\":\"Tỷ giá hối đoái của SABA xu\",\"lbl_RPRebateExample5\":\"<strong>{0}</strong><span>(≈tỷ giá hối đoái USD)</span><span> x </span><strong>100</strong>\",\"lbl_RPRebateExample6\":\"Chúng tôi sẽ điều chỉnh tỷ giá hối đoái của SABA xu dựa trên loại tiền tệ trong tài khoản của bạn và những biến động trên thị trường đô la Mỹ\",\"lbl_RPBeyondExperience\":\"Trải nghiệm không giới hạn\",\"lbl_RPRevealPrivilegeKeys\":\"Hiển thị các khóa đặc quyền\",\"lbl_RPNewLevelUnlocked\":\"Đã mở khóa cấp độ mới\",\"lbl_RPCompleteTask\":\"Hoàn thành nhiệm vụ để kiếm tiền kinh nghiệm và mở khóa thêm lợi ích dành cho thành viên!\",\"lbl_RPGuaranteedSabaCoins\":\"Đăng nhập để chắc chắn nhận được SABA xu\",\"lbl_RPWeeklyReward\":\"Phần thưởng thêm hàng tuần\",\"lbl_RPRankingHonor\":\"Xếp hạng danh dự\",\"lbl_RPExclusiveVouchers\":\"Phiếu thưởng độc quyền\",\"lbl_RPMoreDetails\":\"《Để biết thêm chi tiết, vui lòng kiểm tra các quy định của hệ thống phần thưởng.》\",\"lbl_RPEventName\":\"Chương trình thưởng hàng tuần\",\"lbl_RPClaimWeekR\":\"Đòi lại Ngay\",\"lbl_RPClaimNow\":\"Đòi lại Ngay\",\"lbl_RPError01\":\"Mã lỗi [40001]\",\"lbl_RPError02\":\"Lỗi Hệ thống\",\"lbl_RPError03\":\"Vui lòng thử