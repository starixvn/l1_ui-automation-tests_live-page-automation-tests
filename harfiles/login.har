 rằng bộ phận liên quan của chúng tôi vẫn đang kiểm tra chi tiết liên quan về trận đấu và quá trình này sẽ mất một chút thời gian để giải quyết. Việc giải quyết thanh toán sẽ bắt đầu ngay sau khi quá trình xác minh hoàn tất. Xin lỗi về bất tiện mà quý khách gặp phải.\",\"sport176\":\"FGG\",\"lbl_H5bs\":\"B/S\",\"lbl_H5oe\":\"O/E\",\"lbl_H5s4\":\"4S\",\"lbl_H5mome\":\"MO/ME\",\"lbl_H5cb\":\"CB\",\"lbl_H5total\":\"Tổng số\",\"lbl_NPHP_ErrorCode\":\"Mã lỗi\",\"lbl_CasinoRetry\":\"Rất tiếc, đã xảy ra sự cố.<br/>Vui lòng thử lại.\",\"lbl_SabaLTitle\":\"Khuyến mãi Saba\",\"lbl_SabaLRebatePlan\":\"Chương Trình Hoàn Tiền\",\"lbl_SabaLReplacement\":\"Thay thế\",\"lbl_SabaLReplacementPer\":\"Giai đoạn thay thế\",\"lbl_SabaLPointsPd\":\"Điểm SABA đã thanh toán\",\"lbl_SabaLEventTimeF\":\"Mô tả chương trình khuyến mãi\",\"lbl_SabaLDirectlyInvolved\":\"Có liên quan trực tiếp\",\"lbl_SabaLEnjoyRebate\":\"Hưởng ưu đãi hoàn tiền\",\"lbl_SabaLMultiPromote\":\"Khuyến mãi đa môn thể thao\",\"lbl_SabaLChooseurRebate\":\"Chọn môn thể thao được hoàn tiền của bạn\",\"lbl_SabaLDetailDescrip\":\"Tìm hiểu thêm\",\"lbl_SabaLChooseurSports\":\"Chọn môn thể thao ưa thích của bạn để hoàn tiền\",\"lbl_SabaLSabaGiveRebate\":\"SABA Sports sẽ hoàn tiền cho môn thể thao bạn chọn, khoản lỗ ròng của môn thể thao bạn chọn sẽ được tính riêng và hoàn lại dưới dạng lợi nhuận âm.\",\"lbl_SabaLDefault\":\"(Mặc định)\",\"lbl_SabaLNetLossRebate\":\"Hoàn tiền mặt lỗ ròng 0,4% không giới hạn. Có thể áp dụng cho tất cả trận đấu bóng đá (Kể cả Bóng Đá Saba)\",\"lbl_SabaLMajorEventsAM\":\"Sự kiện lớn trong tháng Tư và tháng Năm\",\"lbl_SabaLBigFiveEuroB\":\"Năm Giải Đấu Bóng Đá Châu Âu \\\"Big Five\\\"\",\"lbl_SabaLChineseFootballB\":\"Giải Super League của Liên Đoàn Bóng Đá Trung Quốc\",\"lbl_SabaLWorldCupQualifiy\":\"Vòng Loại World Cup\",\"lbl_SabaLUnlimitedRebate\":\"Hoàn tiền không giới hạn\",\"lbl_SabaLApplyBasketball\":\"Hoàn tiền mặt lỗ ròng 1,0% không giới hạn. Có thể áp dụng cho tất cả trận đấu Bóng Rổ\",\"lbl_SabaLNbaCbaB\":\"Vòng Loại NBA và CBA\",\"lbl_SabaLApplyTennis\":\"Hoàn tiền mặt lỗ ròng 1,0% không giới hạn. Có thể áp dụng cho tất cả trận đấu Tennis\",\"lbl_SabaLMonteCarlo\":\"Monte Carlo Masters\",\"lbl_SabaLBarecelonaOpen\":\"Barcelona Open\",\"lbl_SabaLMadridMasters\":\"Madrid Masters\",\"lbl_SabaLApplyCricket\":\"Hoàn tiền mặt lỗ ròng 1,0% không giới hạn. Có thể áp dụng cho tất cả trận đấu Cricket\",\"lbl_SabaLApplyESports\":\"Hoàn tiền mặt lỗ ròng 1,0% không giới hạn. Có thể áp dụng cho tất cả trận đấu Thể Thao Điện Tử\",\"lbl_SabaLIndianPremierL\":\"Indian Premier League\",\"lbl_SabaLThanksForSupport\":\"Cảm ơn bạn đã ủng hộ\",\"lbl_SabaLTotalSBPoints\":\"Tổng điểm SABA\",\"lbl_LSatisified\":\"Bạn đánh giá trải nghiệm của bạn với chương trình Saba của chúng tôi như thế nào?\",\"lbl_LLSKnow\":\"Hãy cho Saba biết ý nghĩ của bạn\",\"lbl_LWLimit\":\"Số từ hạn chế\",\"lbl_LSubmit\":\"Gửi\",\"lbl_LNopStatement\":\"Không, chuyển sang kiểm tra báo cáo\",\"lbl_LGreatService\":\"Chương trình tuyệt vời！ Chọn dịch vụ mà bạn hài lòng\",\"lbl_LGoodService\":\"Rất tốt, nhưng phần nào có thể cải thiện tốt hơn nữa?\",\"lbl_LAverageService\":\"Mức độ trung bình, xin cho chúng tôi biết e ngại của bạn.\",\"lbl_LPoorService\":\"Không tốt, xin cho chúng tôi biết e ngại của bạn.\",\"lbl_LDisappointmentService\":\"Thất vọng, xin cho chúng tôi biết e ngại của bạn.\",\"lbl_LInfoClearify\":\"Thông tin chương trình rõ ràng\",\"lbl_LPromotionG\":\"Khuyến mãi hấp dẫn\",\"lbl_LJoinSmooth\":\"Dễ tham gia\",\"lbl_LExchangeSmooth\":\"Dễ quy đổi\",\"lbl_SabaLBadLayout\":\"Thiết kế bố cục không tốt\",\"lbl_SabaLAttractiveLayout\":\"Thiết kế bố cục hấp dẫn\",\"lbl_LRulesComplicate\":\"Thông tin chương trình phức tạp\",\"lbl_LPromotionB\":\"Khuyến mãi không hấp dẫn\",\"lbl_LJoinComplicate\":\"Không dễ tham gia\",\"lbl_LExchangeHard\":\"Không dễ quy đổi\",\"lbl_LRulesHard\":\"Các quy tắc khó hiểu\",\"lbl_LThanksFeedback\":\"Xin chân thành cảm ơn bạn đã ủng hộ và đóng góp ý kiến phản hồi\",\"lbl_SabaLChosenRebateSport\":\"Môn thể thao được hoàn tiền bạn chọn\",\"lbl_SabaLBetNow\":\"CƯỢC NGAY！\",\"lbl_SabaLYouGot\":\"Bạn có\",\"lbl_SabaLSabaEight\":\"Khuyến mãi SABA Sports, hoàn tiền mặt 1% không giới hạn\",\"lbl_SabaLDesciptionPromote\":\"Mô tả khuyến mãi:\",\"lbl_SabaLThreeStage_1012\":\"Thời gian khuyến mãi của chương trình SABA sẽ có hiệu lực trong 5 giai đoạn. Thời gian sự kiện: Từ ngày 21/11/2022, 00:00:00 đến ngày 25/12/2022, 23:59:59 (GMT-4). Hạn chót quy đổi: Ngày 01/01/2023, 23:59:59 (GMT-4).\",\"lbl_SabaLNetTwentyFour\":\"Mỗi lần hoàn tiền mặt của lượng lỗ ròng sẽ được tính vào các ngày 8, 18, 28 tháng Tư vào lúc 12:00 trưa (GMT+8). Khoản tiền hoàn lại sẽ được giao trong vòng 24 giờ sau khi tính toán.\",\"lbl_SabaLCashRebateA\":\"Các thành viên sẽ được nhận phần thưởng hoàn tiền mặt lỗ ròng cho môn Thể Thao như sau:\",\"lbl_SabaLRSoccerC\":\"Nếu môn thể thao là Bóng Đá thì thành viên sẽ nhận được mức hoàn tiền 0,3% cho mỗi 1,00 lỗ ròng trong một lượt chơi.\",\"lbl_SabaLRBasketballC\":\"Nếu môn thể thao là Bóng Rổ thì thành viên sẽ nhận được mức hoàn tiền 1.0% cho mỗi 1,00 USD lỗ ròng trong một lượt chơi.\",\"lbl_SabaLRTennisC\":\"Nếu môn thể thao là Tennis thì thành viên sẽ nhận được mức hoàn tiền 1.0% cho mỗi 1,00 lỗ ròng trong một lượt chơi.\",\"lbl_SabaLRCricketC\":\"Nếu môn thể thao là Cricket thì thành viên sẽ nhận được mức hoàn tiền 1.0% cho mỗi 1,00 lỗ ròng trong một lượt chơi.\",\"lbl_SabaLESportsC\":\"Nếu môn thể thao là Thể Thao Điện Tử thì thành viên sẽ nhận được mức hoàn tiền 1.0% cho mỗi 1,00 lỗ ròng trong một lượt chơi.\",\"lbl_SabaLSabaPointC\":\"Đơn vị hoàn tiền sẽ là điểm SABA. 1 điểm SABA = 1 USD tiền mặt (đơn vị tiền tệ sẽ căn cứ theo đơn vị tiền tệ trong tài khoản của thành viên).\",\"lbl_SabaLTakenDeadline\":\"Điểm SABA sẽ bị lấy lại sau hạn chót quy đổi.\",\"lbl_SabaLRulePromote\":\"Quy định khuyến mãi:\",\"lbl_SabaLKPL\":\"King Pro League\",\"lbl_SabaLLPL\":\"Giải Đấu Liên Minh Huyền Thoại Chuyên Nghiệp\",\"lbl_SabaLLCK\":\"Vô Địch Liên Minh Huyền Thoại Hàn Quốc\",\"lbl_SabaLCSGO\":\"ESL Pro League\",\"lbl_SabaLQualify\":\"Đã đủ điều kiện\",\"lbl_SabaLMoveOn\":\"Đi tới trang sự kiện\",\"lbl_SabaLDoNotHavePoint\":\"Chưa có điểm nào\",\"lbl_SabaLRR1\":\"Phần thưởng hoàn lại tiền mặt CHỈ có thể nhận được bởi các thành viên SABA kiếm được / lỗ ròng trong thời gian khuyến mãi.\",\"lbl_SabaLRR2\":\"Lỗ ròng là khi tổng tiền cược vượt quá tổng doanh thu trong kỳ của người chơi, được tính bằng tổng doanh thu trừ đi tổng tiền cược. Các cược đã đặt và kết toán trong cùng một kỳ sẽ được dùng để tính lỗ ròng. Chỉ có các cược ở một số môn thể thao nhất định mới đủ điều kiện được hoàn tiền. Chương trình ưu đãi này sẽ không áp dụng cho Cược Xiên và Bán Vé Cược.\",\"lbl_SabaLRR3\":\"Nếu chương trình gặp khó khăn về kỹ thuật, phần thưởng hoàn tiền sẽ tiếp tục cộng dồn và sẽ được ghi có vào tài khoản của thành viên khi chương trình hoạt động trở lại.\",\"lbl_SabaLRR4\":\"SABA có toàn quyền bảo lưu quyền chấm dứt chương trình SABA và thay đổi, hạn chế, sửa đổi hoặc thêm quy tắc, quy định, điều khoản và điều kiện của chương trình SABA, vào bất cứ thời điểm nào mà không cần thông báo trước. Điều này bao gồm nhưng không giới hạn ở việc đặt ra giới hạn thời gian và thay đổi khoản hoàn tiền, phần thưởng và các mức thưởng.\",\"lbl_SabaLRR5\":\"SABA bảo lưu quyền chấm dứt và/hoặc hủy ưu đãi thành viên của những thành viên đã được cấp, nhận hoặc đổi thưởng do lỗi của máy tính, gian lận hoặc trộm cắp, và/hoặc bằng các phương tiện bất hợp pháp hoặc theo cách thức không được cho phép trong các quy định và quy tắc chính thức và các điều khoản và điều kiện của chương trình SABA.\",\"lbl_SabaLRR6\":\"SABA sẽ không bao giờ chia sẻ hoặc bán danh sách thành viên chương trình SABA.\",\"lbl_SabaLRR7\":\"Nhân viên của SABA không được tham gia chương trình SABA.\",\"lbl_SabaLRR8\":\"Bằng cách đăng ký tham gia chương trình, thành viên đồng ý chịu ràng buộc theo các điều khoản và điều kiện này. Các quy định liên quan đến phần thưởng SABA cũng như các ưu đãi đặc biệt và hoàn tiền khác nhau có thể thay đổi mà không thông báo trước.\",\"lic_loyaltyResetPwdMsg01\":\"Vui lòng bấm vào liên kết dưới đây để đặt lại mật khẩu. <br/>\\n <a href=\\\"{0}\\\" target=\\\"_LoyaltyRPWD\\\">[Bấm vào đây để xác thực và đặt lại mật khẩu]</a><br/>\\n Vì lý do an ninh, liên kết đặt lại sẽ hết hạn sau 24 giờ.\",\"lic_loyaltyRandR\":\"<div class=\\\"ly-content\\\">\\n    <div class=\\\"ly-content-panel\\\">\\n        <div class=\\\"ly-p\\\">\\n            <label class=\\\"text-title\\\">Thời gian sự kiện：</label>\\n            <span>12:00 18/10/2021 ~ 12:00 15/11/2021 (GMT+8). </span>\\n        </div>\\n        <div class=\\\"ly-p\\\">\\n            <label class=\\\"text-title\\\">Yêu Cầu Đối Với Thành Viên：</label>\\n            <span>Hội đủ tiêu chuẩn để nhận hoàn tiền 0,7% SABA khi các khoản cược được đặt của tuần dẫn đến khoản lỗ ròng.</span>\\n        </div>\\n\\n    </div>\\n\\n    <div class=\\\"ly-table\\\">\\n        <div class=\\\"ly-table__head\\\">\\n\\n            <div class=\\\"ly-text-title\\\">\\n                <i class=\\\"lyicon lyicon-sabapoint\\\"></i>\\n            </div>\\n            <div class=\\\"ly-text-title\\\">Cách để nhận hoàn tiền</div>\\n        </div>\\n        <div class=\\\"ly-table__body\\\">\\n\\n            <div class=\\\"ly-table-block\\\">\\n                <div class=\\\"ly-table-tr\\\">\\n                    <div class=\\\"ly-table-td\\\">\\n                        <b class=\\\"ly-text-highlight\\\">Các loại thể thao</b>\\n                    </div>\\n                    <div class=\\\"ly-table-td\\\">\\n                        <b class=\\\"ly-text-highlight\\\">Điểm hoàn tiền</b>\\n                    </div>\\n                </div>\\n                <div class=\\\"ly-table-tr\\\">\\n                    <div class=\\\"ly-table-td\\\">\\n                        <span>Bóng đá</span>\\n                    </div>\\n                    <div class=\\\"ly-table-td\\\">\\n                        <span>0.5%/Điểm</span>\\n                    </div>\\n                </div>\\n                <div class=\\\"ly-table-tr\\\">\\n                    <div class=\\\"ly-table-td\\\">\\n                        <span>Các môn Thể Thao trừ Bóng Đá</span>\\n                    </div>\\n                    <div class=\\\"ly-table-td\\\">\\n                        <span>0.7%/Điểm</span>\\n                    </div>\\n                </div>\\n            </div>\\n            <div class=\\\"ly-table-block\\\">\\n                <div class=\\\"ly-table-rowspan\\\">\\n                    <b class=\\\"ly-text-highlight\\\">\\n                        Cược tuần ≥ 5 phiếu cược có thể tiếp tục vào tuần sau\\n                    </b>\\n                </div>\\n            </div>\\n        </div>\\n    </div>\\n\\n    <div class=\\\"ly-content-panel\\\">\\n        \\n        <div class=\\\"ly-divider\\\"></div>\\n\\n        <div class=\\\"ly-p\\\">\\n            <label class=\\\"text-title\\\">Yêu Cầu Đối Với Thành Viên:</label>\\n        </div>\\n        <ul class=\\\"ly-ul\\\">\\n            <li class=\\\"ly-li\\\">Thời gian khuyến mãi của chương trình SABA sẽ có hiệu lực trong 4 tuần. Thời gian sự kiện: Từ ngày 18/10/2021, 12:00 giờ trưa đến ngày 15/11/2021, 12:00 trưa (GMT+8). Hạn chót quy đổi: Ngày 22/11/2021, 12:00 giờ trưa (GMT+8).</li>\\n            <li class=\\\"ly-li\\\">Mỗi khoản ưu đãi hoàn tiền mặt của số tiền lỗ ròng sẽ được tính toán vào Thứ Hai lúc 12:00 giờ trưa (GMT+8) bắt đầu từ ngày tham gia. Khoản tiền hoàn lại sẽ được giao trong vòng 12 giờ sau khi tính toán.</li>\\n            <li class=\\\"ly-li\\\">Các thành viên sẽ được nhận phần thưởng hoàn tiền mặt lỗ ròng tùy theo loại Thể Thao và số lượng khoản cược:\\n                <ul class=\\\"ly-ul\\\">\\n                    <li class=\\\"ly-li\\\">Thành Viên phải đặt 5 khoản cược trong một tuần.</li>\\n                    <li class=\\\"ly-li\\\">Nếu loại Thể Thao là Bóng Đá thì Thành Viên sẽ được thưởng khoản hoàn tiền mặt trị giá 0,5% mỗi 1,00 USD lỗ ròng trong một tuần.</li>\\n                    <li class=\\\"ly-li\\\">Nếu loại Thể Thao không phải là Bóng Đá (trong đó có Thể Thao Điện Tử SABA và Thể Thao Ảo) thì thành viên sẽ được thưởng khoản hoàn tiền mặt trị giá 0,7% mỗi 1,00 USD lỗ ròng trong một tuần.</li>\\n                </ul>\\n            </li>\\n                                        <li class=\\\"ly-li\\\">Đơn vị hoàn tiền sẽ là điểm SABA. 1 điểm SABA = 1 USD tiền mặt (đơn vị tiền tệ sẽ căn cứ theo đơn vị tiền tệ trong tài khoản của thành viên).</li>\\n                                        \\n            <li class=\\\"ly-li\\\">Điểm SABA chưa nhận sẽ bị hủy bỏ sau thời hạn quy đổi.</li>\\n        </ul>\\n        <div class=\\\"ly-p\\\">\\n            <label class=\\\"text-title\\\">Quy Tắc Và Quy Định：</label>\\n        </div>\\n        <ul class=\\\"ly-ul\\\">\\n            <li class=\\\"ly-li\\\">CHỈ có thành viên SABA bị một hoặc nhiều khoản lỗ ròng hàng tuần trong giai đoạn khuyến mãi mới được quyền nhận phần thưởng hoàn tiền mặt.</li>\\n            <li class=\\\"ly-li\\\">Tiền lỗ ròng được tính bằng cách lấy tổng số tiền thắng cược tuần của thành viên trừ đi số tiền đặt cược. Nếu tổng số tiền đặt cược lớn hơn tổng số tiền thắng cược thì tức là thành viên đó có khoản lỗ ròng. Các khoản cược đã đặt và được quyết toán trong cùng một tuần được đưa vào phép toán. Chỉ có các khoản cược đặt trong Sportsbook (bao gồm Thể Thao Điện Tử SABA, Thể Thao Ảo và Thể Thao Ảo SABA) mới ủ điều kiện hưởng ưu đãi hoàn tiền mặt. Rút Tiền Mặt (Cash Out) không bao gồm trong chương trình khuyến mãi này.</li>\\n            \\n            <li class=\\\"ly-li\\\">Nếu chương trình gặp khó khăn về kỹ thuật, phần thưởng hoàn tiền sẽ tiếp tục cộng dồn và sẽ được ghi có vào tài khoản của thành viên khi chương trình hoạt động trở lại. </li>\\n            <li class=\\\"ly-li\\\">SABA có toàn quyền bảo lưu quyền chấm dứt chương trình SABA và thay đổi, hạn chế, sửa đổi hoặc thêm quy tắc, quy định, điều khoản và điều kiện của chương trình SABA, vào bất cứ thời điểm nào mà không cần thông báo trước. Điều này bao gồm nhưng không giới hạn ở việc đặt ra giới hạn thời gian và thay đổi khoản hoàn tiền, phần thưởng và các mức thưởng.</li>\\n            <li class=\\\"ly-li\\\">SABA bảo lưu quyền chấm dứt và/hoặc hủy ưu đãi thành viên của những thành viên đã được cấp, nhận hoặc đổi thưởng do lỗi của máy tính, gian lận hoặc trộm cắp, và/hoặc bằng các phương tiện bất hợp pháp hoặc theo cách thức không được cho phép trong các quy định và quy tắc chính thức và các điều khoản và điều kiện của chương trình SABA.</li>\\n            <li class=\\\"ly-li\\\">SABA sẽ không bao giờ chia sẻ hoặc bán danh sách thành viên chương trình SABA. </li>\\n            <li class=\\\"ly-li\\\">Nhân viên của SABA không được tham gia chương trình SABA. </li>\\n            <li class=\\\"ly-li\\\">Bằng cách đăng ký tham gia chương trình, thành viên đồng ý chịu ràng buộc theo các điều khoản và điều kiện này. Các quy định liên quan đến phần thưởng SABA cũng như các ưu đãi đặc biệt và hoàn tiền khác nhau có thể thay đổi mà không thông báo trước.</li>\\n        </ul>\\n    </div>\\n</div>\",\"lic_loyaltyForgotPwdMsg01\":\"Vui lòng kiểm tra Thư Cá nhân của bạn để biết URL đặt lại mật khẩu.\",\"lbl_SabaLEventTime2_1012\":\"21/11/2022 ~ 25/12/2022 SABA Sports sẽ hoàn tiền cho môn thể thao bạn chọn, khoản lỗ ròng của môn thể thao bạn chọn sẽ được tính riêng và hoàn lại dưới dạng lợi nhuận âm.\",\"lbl_ok\":\"OK\",\"lbl_2\":\"Bóng rổ\",\"lbl_1\":\"Bóng đá\",\"lbl_43\":\"Thể thao điện tử\",\"lbl_50\":\"Cricket\",\"lbl_5\":\"Quần vợt\",\"lbl_Streamer\":\"Live Streamer\",\"lbl_StreamerX\":\"Live Streamer {0}\",\"lbl_CashOutDisabledCrd\":\"Tài khoản của bạn không thể bán vé cược, vui lòng liên hệ cấp trên của bạn để bật tính năng này.\",\"lbl_CashOutHtry\":\"Lịch Sử Rút Tiền Mặt\",\"lbl_CashOutAmt\":\"Số Tiền Rút Tiền Mặt\",\"lbl_DateTime\":\"Ngày/Giờ\",\"lbl_Activity\":\"Hoạt động\",\"lbl_CashOutCncld\":\"Rút Tiền Mặt Đã Bị Hủy\",\"lbl_CashOutRcvrd\":\"Rút Tiền Mặt Đã Được Phục Hồi\",\"lbl_SabaLCrazyRebate\":\"Chương trình giảm giá độc quyền bắt đầu ngay bây giờ！\",\"lbl_2022NLookMainTtl\":\"Một Diện Mạo Mới Mẻ！\",\"lbl_2022NLookMainTtl_Lic\":\"Một Diện Mạo Mới Mẻ！\",\"lbl_2022NLookMainTxt1\":\"Diễn Biến Nóng Bỏng - Cập Nhật Liên Tục\",\"lbl_2022NLookMainTxt2\":\"Giao Diện Cược Mới - Thuận Tiện Đối Chiếu\",\"lbl_2022NLookMainTxt3\":\"Đổi vị trí của “Loại tỷ lệ cược” và “Cược nhanh”\",\"lbl_2022NLookMainTxt4\":\"Thêm Nhiều Tính Năng - Dễ Dàng Đặt Cược\",\"lbl_GetStarted\":\"Bắt đầu\",\"lbl_2022NLookSub2\":\"Diễn Biến Nóng Bỏng - Cập Nhật Liên Tục\",\"lbl_2022NLookSub2Txt\":\"Chuyển mục \\\"Yêu thích của tôi\\\" và phần diễn biến xuống dưới tên đội\",\"lbl_2022NLookSub3\":\"Giao Diện Cược Mới\",\"lbl_2022NLookSub3Txt\":\"Đặt tên loại cược cạnh tên giải đấu\",\"lbl_2022NLookSub4\":\"Bố trí lại tính năng \\\"Một/Hai Dòng\\\" và \\\"Sắp xếp trận đấu\\\"\",\"lbl_2022NLookSub4Txt\":\"Chọn cách hiển thị tỷ lệ cược và sắp xếp trận đấu cho từng môn thể thao\",\"lbl_2022NLookSub5\":\"Đổi vị trí của “Loại tỷ lệ cược” và “Cược nhanh”\",\"lbl_2022NLookSub5Txt\":\"Chuyển các thiết lập này lên trên để tiện tùy chỉnh\",\"lbl_2022NLookSub6\":\"Mở Rộng Giao Diện Tổng Thể\",\"lbl_2022NLookSub6Txt\":\"Mở rộng giao diện để thêm nhiều tính năng hơn\",\"lbl_StartBetNow_btn\":\"Đặt Cược Ngay\",\"lbl_SportsMines\":\"Dò Mìn Thể Thao\",\"lbl_SM4605\":\"Dò Mìn Bóng Đá\",\"lbl_SM4606\":\"Dò Mìn Bóng Rổ\",\"lbl_SM4607\":\"Dò Mìn Cricket\",\"lbl_SocXMines\":\"Bóng Đá {0} Quả Mìn\",\"lbl_BsktXMines\":\"Bóng Rổ {0} Quả Mìn\",\"lbl_CrktXMines\":\"Cricket {0} Quả Mìn\",\"lbl_SMMines\":\"Mìn\",\"lbl_Join\":\"Join\",\"lbl_WinUpTo\":\"Win Up To\",\"lbl_ChangeTbl\":\"Đổi Bàn\",\"lbl_Playing\":\"Đang chơi\",\"lbl_NewGame\":\"Phần chơi mới\",\"lbl_ClickBlkStGMsg\":\"Vui lòng nhấp vào khối bất kỳ để bắt đầu trò chơi.\",\"lbl_1Ball\":\"1 Bóng\",\"lbl_XBalls\":\"{0} Bóng\",\"lbl_N