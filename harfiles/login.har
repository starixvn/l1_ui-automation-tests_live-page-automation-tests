et_limit_change\":\"Hạn mức cược của bạn vừa được cập nhật.\",\"message_cannot_bet\":\"Không thể đặt cược vào lúc này.\",\"message_close_account\":\"Tài khoản đã bị đóng. Phiên đăng nhập sẽ hết hạn sau 10 giây. Vui lòng liên hệ với cấp trên để biết thêm chi tiết. (%{errorCode})\",\"message_connection_failed\":\"Không thể kết nối tới máy chủ.\",\"message_data_processing\":\"Tài khoản bị đăng xuất do có người khác đăng nhập vào tài khoản này.\",\"message_disabled_game\":\"Game đang được bảo trì, vui lòng quay lại sau 10 phút.\",\"message_download_first_visit\":\"Lần truy cập đầu tiên, việc tải dữ liệu sẽ mất chút thời gian.\",\"message_endgame_failed\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nĐã xảy ra lỗi. Vui lòng liên hệ với bộ phận CSKH để được hỗ trợ. (%{errorCode})\",\"message_enter_portal_failed\":\"Đã xảy ra lỗi. Vui lòng liên hệ với bộ phận CSKH để được hỗ trợ. (%{errorCode})\",\"message_error_occurred\":\"Đã xảy ra lỗi. Vui lòng liên hệ với bộ phận CSKH để được hỗ trợ. (%{errorCode})\",\"message_error_occurred_full\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nĐã xảy ra lỗi. Vui lòng liên hệ với bộ phận CSKH để được hỗ trợ. (%{errorCode})\",\"message_error_occurred_place_bet\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nĐã xảy ra lỗi. Vui lòng liên hệ với bộ phận CSKH để được hỗ trợ. (%{errorCode})\",\"message_exist_nickname\":\"Tên nhân vật đã tồn tại.\",\"message_game_under_maintain\":\"Hệ thống đang được bảo trì. Vui lòng quay lại sau.\",\"message_get_balance_failed\":\"Không thể cập nhật số tiền trong tài khoản. (%{errorCode})\",\"message_hedge_bet\":\"Chỉ có thể đặt cược trên %{betChoice1} hoặc %{betChoice2}.\",\"message_insufficient_fund\":\"Tài khoản của bạn thiếu tiền. (%{errorCode})\",\"message_invalid_bet_choice\":\"Cửa cược không hợp lệ.\",\"message_invalid_cashout\":\"Rút tiền không thành công.\",\"message_invalid_data\":\"Dữ liệu không hợp lệ.\",\"message_invalid_deal_dueto_running_round\":\"Cược không hợp lệ do phiên chưa kết thúc.\",\"message_invalid_value_cashout\":\"Giá trị tự động rút tiền không hợp lệ.\",\"message_ip_restricted\":\"Địa chỉ IP này bị chặn. (%{errorCode})\",\"message_ip_restricted_place_bet\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nĐịa chỉ IP này bị chặn. Đặt cược thất bại! (%{errorCode})\",\"message_jackpot_processing\":\"Dữ liệu đang được xử lý, giải thưởng Nổ Hũ sẽ được cập nhật vào tài khoản của bạn sau ít phút.\",\"message_limit_bet_not_defined\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nHạn mức cược của bạn cho trò chơi này chưa được thiết lập. Vui lòng liên hệ với cấp trên. Đặt cược thất bại! (%{errorCode})\",\"message_limit_bet_updated\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nHạn mức cược của bạn đã được cập nhật, vui lòng thử lại. Đặt cược thất bại! (%{errorCode})\",\"message_limitbet_exceeded\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nKhoản tiền cược của bạn đã vượt quá cài đặt giới hạn cược, vui lòng thử lại. Đặt cược thất bại! (%{errorCode})\",\"message_login_fail_place_bet\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nTài khoản hoặc mật khẩu đăng nhập không đúng. Đặt cược thất bại!\",\"message_lose_limit_hit\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nĐã đạt giới hạn thua cược! Vui lòng liên hệ với cấp trên, cảm ơn bạn. Đặt cược thất bại! (%{errorCode})\",\"message_lost_game_connection\":\"%{gameName}\\\\n\\\\nMất kết nối hoặc kết nối không ổn định. Vui lòng kiểm tra và thử lại.\",\"message_maxbet_of_oneofchoice_reached\":\"Tiền cược của một trong các cửa vượt mức quy định.\",\"message_min_bet_notice\":\"Tiền cược tối thiểu là %{minBet}\",\"message_network_error\":\"Lỗi kết nối mạng. (%{errorCode})\",\"message_network_error_place_bet\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nLỗi kết nối mạng. Đặt cược thất bại! (%{errorCode})\",\"message_new_update_available\":\"Vui lòng tải lại trang để cập nhật phiên bản mới.\",\"message_nickname_character\":\"Không gõ dấu tiếng việt, không chứa khoảng trắng và các ký tự đặc biệt.\",\"message_nickname_distance\":\"Tên nhân vật phải có từ 3 đến 14 ký tự.\",\"message_no_game_offer\":\"Tài khoản của bạn không được hỗ trợ trên cổng game này. Vui lòng liên hệ với cấp trên.\",\"message_not_enough_scoin\":\"Bạn hiện không có đủ Scoin để cược.\",\"message_option_maxbet\":\"Tiền cược tối đa ở cửa này là %{maxBet}\",\"message_place_bets\":\"Mời Đặt Cược\",\"message_placebet_failed\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nĐặt cược không thành công! (%{errorCode})\",\"message_placebet_next_round\":\"Vui lòng đặt cược ở phiên sau.\",\"message_play_on_otherdevice\":\"Bạn hoặc ai đó đang chơi [game] bằng tài khoản này.\",\"message_player_unpermitted_play\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nTrò chơi bị vô hiệu hóa. Vui lòng liên hệ với cấp trên để biết chi tiết, cảm ơn bạn. (%{errorCode})\",\"message_processing_action\":\"Cược đang được xử lý. Vui lòng đợi trong giây lát.\",\"message_rotate_device\":\"Vui lòng xoay màn hình của bạn.\",\"message_round_maxbet\":\"Tổng tiền cược tối đa ở phiên này là %{maxBet}\",\"message_server_error\":\"Máy chủ gặp sự cố.\",\"message_server_not_found\":\"Không tìm thấy máy chủ.\",\"message_session_expired\":\"Đã hết phiên đăng nhập. Vui lòng tải lại trang.\",\"message_session_timeout\":\"Phiên đăng nhập của bạn đã hết. Vui lòng đợi để tải lại trang.\",\"message_stop_bet\":\"Dừng Đặt Cược\",\"message_sys_maintenance\":\"Hệ thống đang được bảo trì.\",\"message_sys_maintenance_place_bet\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nHệ thống đang được bảo trì.\",\"message_unauthorized\":\"Không được phép.\",\"message_unavailable_game\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nTrò chơi không khả dụng vào thời điểm này. Vui lòng liên hệ với bộ phận CSKH để biết chi tiết, cảm ơn bạn. (%{errorCode})\",\"message_under_maintain\":\"HỆ THỐNG ĐANG ĐƯỢC BẢO TRÌ. VUI LÒNG QUAY LẠI SAU.\",\"message_user_not_found\":\"Không tìm thấy người chơi này. (%{errorCode})\",\"message_user_notfound_place_bet\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nKhông tìm thấy người chơi này. Đặt cược thất bại! (%{errorCode})\",\"message_void_running_ticket\":\"Cược của bạn đã bị hủy vì lý do kỹ thuật. Vui lòng thử lại game.\",\"message_win_limit_hit\":\"Game %{gameName} (#%{gameRoundId})\\\\n\\\\nĐã đạt giới hạn thắng cược! Vui lòng liên hệ với cấp trên, cảm ơn bạn. Đặt cược thất bại! (%{errorCode})\",\"min_bet_hand\":\"Tiền cược tối thiểu của tay bài này là %{minBet}\",\"name_invalid\":\"Tên nhân vật không hợp lệ.\",\"nickname_requirement\":\"Lưu ý:\\\\n+ Tên nhân vật phải có từ 3 đến 14 ký tự.\\\\n+ Không gõ dấu tiếng việt, không chứa khoảng trắng và các ký tự đặc biệt.\\\\n+ Không thể đổi tên nhân vật sau khi tạo.\",\"non_winning_payline\":\"Không có dòng cược thắng\",\"not_enough_money\":\"Bạn hiện không có đủ tiền để cược.\",\"notice\":\"Thông báo\",\"odds\":\"Tỷ Lệ Cược\",\"ok\":\"OK\",\"one_choice_allowed\":\"Chỉ được cược 1 bên.\",\"pf_ header_merge_client_seed\":\"Kết hợp Client Seed \",\"pf_button_clear\":\"Xóa\",\"pf_button_save\":\"Lưu\",\"pf_button_verify\":\"Xác Minh\",\"pf_client_seed_para_1\":\"(Không thể thay đổi Client Seed sau khi đặt cược thành công)\",\"pf_client_seed_para_2\":\"Được tạo ra ngẫu nhiên ở phiên mới\",\"pf_client_seed_para_3\":\"Tự nhập giá trị\",\"pf_client_seed_para_4\":\"Giá trị ngẫu nhiên\",\"pf_client_seed_tooltip\":\"Client Seed được tạo ra từ phía người chơi.\\\\nChuỗi \\\\\"Kết hợp Client Seed\\\\\" được tạo thành bằng sự kết hợp Client Seed của 5 người chơi theo thứ tự từ Người Chơi 1 đến Người Chơi 5.\",\"pf_client_seed_tooltip_para_1\":\"Client Seed được tạo ra từ phía người chơi.\",\"pf_client_seed_tooltip_para_2\":\"Chuỗi \\\\\"Kết hợp Client Seed\\\\\" được tạo thành bằng sự kết hợp Client Seed của 5 người chơi theo thứ tự từ Người Chơi 1 đến Người Chơi 5.\",\"pf_combined_sha512_hash_tooltip_para_1\":\"Kết quả cuối cùng được xác định dựa trên sự kết hợp giữa Server Seed và Client Seed của 5 người chơi đặt cược đầu tiên và được mã hóa dưới dạng SHA512 hash.\",\"pf_copy_successfully \":\"Copy thành công!\",\"pf_copy_unsucessful\":\"Chức năng Copy tạm thời không hoạt động.\",\"pf_fairness\":\"Minh Bạch\",\"pf_header_client_seed\":\"Client Seed\",\"pf_header_combined_sha512_hash\":\"Chuỗi SHA512 hash\",\"pf_header_server_seed\":\"Server Seed\",\"pf_header_server_seed_sha256\":\"Server Seed SHA256\",\"pf_new_client_seed_para_1\":\"Seed của bạn:\",\"pf_player_1\":\"Người Chơi 1\",\"pf_player_2\":\"Người Chơi 2\",\"pf_player_3\":\"Người Chơi 3\",\"pf_player_4\":\"Người Chơi 4\",\"pf_player_5\":\"Người Chơi 5\",\"pf_player_seed\":\"Người Chơi {value} Seed\",\"pf_pop-up_title_pf_guide\":\"Hướng Dẫn Provably Fair\",\"pf_provably_fair_para_2\":\"Bạn có thể xác minh tính chính xác của chuỗi SHA256 hoặc SHA512 trong game bằng bất kỳ công cụ trực tuyến do bên thứ ba cung cấp.\",\"pf_settings_para_1\":\"Kết quả cuối cùng được xác định dựa trên sự kết hợp giữa Server Seed và Client Seed của 5 người chơi đặt cược đầu tiên.\",\"pf_settings_para_2\":\"Người chơi có thể thay đổi giá trị Client Seed và kiểm tra tính minh bạch của kết quả trong mục Lịch sử cược.\",\"pf_title_new_client_seed\":\"CLIENT SEED MỚI\",\"pf_title_provably_fair\":\"PROVABLY FAIR\",\"pf_title_provably_fair_settings\":\"CÀI ĐẶT PROVABLY FAIR\",\"pf_title_verification\":\"XÁC MINH\",\"pf_verification_para_1\":\"Kết Quả Cuối Cùng\",\"pf_verification_para_2\":\"Lấy {value} ký tự đầu tiên trong chuỗi SHA512:\",\"pf_verification_para_3\":\"Đổi Sang Hệ Thập Phân\",\"pf_verification_para_4\":\"Tính Kết Quả \",\"powered_by_vgaming\":\"Được cung cấp bởi Vgaming\",\"promotion\":\"Khuyến Mãi\",\"promotion_terms_and_conditions\":\"Điều Khoản Khuyến Mãi\",\"result\":\"Kết Quả\",\"round\":\"Phiên\",\"splash_check_downloading\":\"Đang kiểm tra và tải gói cập nhật game mới nhất...\",\"splash_connection_lost\":\"Mất kết nối hoặc kết nối không ổn định. Vui lòng kiểm tra và thử lại.\",\"splash_login_failed\":\"Đăng nhập thất bại, bạn hãy làm lại thao tác đăng nhập từ đầu.\",\"stake\":\"Cược\",\"submit\":\"XÁC NHẬN\",\"terms_and_conditions_content\":\"- Tất cả người chơi đều có thể tham gia các chương trình khuyến mãi và có cơ hội giành được những giải thưởng hấp dẫn.\\\\n- Tiền thắng được tính toán dựa theo quy định của chương trình khuyến mãi và tỷ lệ trả thưởng.\\\\n- Chương trình khuyến mãi chỉ được áp dụng trong một khoảng thời gian nhất định do Công ty quy định. Khi chương trình khuyến mãi kết thúc, tỷ lệ trả thưởng sẽ được điều chỉnh trở về như ban đầu.\\\\n- Trong một số tình huống, thể lệ chương trình có thể thay đổi mà không cần thông báo trước.\\\\nTrong mọi trường hợp xảy ra tranh chấp, quyết định của Công ty sẽ là quyết định cuối cùng.\",\"time\":\"Thời Gian\",\"total\":\"Tổng\",\"total_stake\":\"Tổng Cược\",\"total_win\":\"Tổng Thắng\",\"under_maintenance_suggest\":\"Sau thời gian bảo trì, bạn hãy đăng nhập lại để có thể tiếp tục chơi game.\",\"under_maintenance_time\":\"Thời gian bảo trì từ %{startTime} đến %{endTime} (GMT+8).\",\"win\":\"Thắng\",\"win_loss\":\"Thắng Thua\",\"you_reach_max_win\":\"Bạn Đã Đạt Mức Tiền Thắng Tối Đa\",\"bet_info\":\"Thông báo\",\"bet_accepted\":\"Đã Chấp Nhận Cược\",\"total_bets\":\"Tổng Đặt Cược\",\"min_bet\":\"Min\",\"max_bet\":\"Max\",\"payout\":\"Trả Thưởng\",\"btn_bet\":\"Cược\",\"btn_cancel\":\"Hủy\",\"result_no\":\"Phiên\",\"result_title\":\"Kết quả\",\"open_result\":\"Công bố kết quả\",\"statistic_title\":\"Thống Kê\",\"scoreboard\":\"Bảng tỷ số\",\"match\":\"Trận đấu\",\"previous_round\":\"Các phiên trước\",\"morethanmax\":\"Tiền cược của bạn vượt mức cược tối đa\",\"lessthanmin\":\"Tiền cược của bạn thấp hơn mức cược tối thiểu\",\"decimal\":\"Dec\",\"connect_failed\":\"Mất kết nối hoặc kết nối không ổn định. Vui lòng kiểm tra và thử lại.\",\"reconnect\":\"Kết nối\",\"sucbet\":\"Cược Thành Công\",\"turn_off_notification\":\"Tắt thông báo này\"},\"SeDie\":{\"game_vendor\":\"SABA.games\",\"game_name\":\"Xóc Đĩa\",\"choices_type1\":\"Lẻ/Chẵn\",\"choices_type2\":\"Đỏ/Trắng\",\"glossary_even\":\"Ch