",\"lbl_SP_RglrTip\":\"Ba lựa chọn.Hai lá bài thành công và một lá bài thất bại.Vui lòng chọn một.\",\"lbl_SP_AfBetTip\":\"Mỗi ván chỉ được 1 khoản cược.\",\"lbl_SP_R1WTip1\":\"Xin chúc mừng！\",\"lbl_SP_R1WTip2\":\"Tiếp tục chọn một để thắng thêm. Biến tiền thắng cược của bạn {0}x thành {1}x\",\"lbl_SP_R1WTip3\":\"Hoặc nhấn nút này để lấy tiền thắng cược của bạn.\",\"lbl_SP_NRound\":\"Ván tiếp theo\",\"lbl_ShowLiveScore\":\"Show Live Score\",\"pattern_bet_bettype219\":\"Điểm Chấp Set {0}\",\"pattern_bet_bettype220\":\"Tài/Xỉu Tổng Điểm Set {0}\",\"bettype3900\":\"Tỷ Số Chính Xác\",\"bettype3901\":\"Giao Bóng Trước\",\"bettype3902\":\"Điểm Cao Nhất Tổng Set\",\"pattern_bet_bettype3903\":\"Bên Chiến Thắng Set {0} (Ghi Trước 15 Điểm)\",\"pattern_bet_bettype3904\":\"Điểm Chấp Set {0} (Ghi Trước 15 Điểm)\",\"pattern_bet_bettype3905\":\"Tài/Xỉu Tổng Điểm Set {0} (Ghi Trước 15 Điểm)\",\"pattern_bet_bettype3906\":\"Lẻ/Chẵn Tổng Điểm Set {0}\",\"pattern_bet_bettype3907\":\"Tài/Xỉu Đội Nhà Set {0}\",\"pattern_bet_bettype3908\":\"Tài/Xỉu Đội Khách Set {0}\",\"pattern_bet_bettype3909\":\"Bên Chiến Thắng {1} Điểm Set {0}\",\"pattern_bet_bettype3910\":\"Tỷ Số Set {0}\",\"pattern_bet_bettype3911\":\"Cách Biệt Thắng Set {0}\",\"pattern_bet_bettype3912\":\"Ghi Trước {1} Điểm Set {0}\",\"pattern_bet_bettype3913\":\"Bên Chiến Thắng & Tổng điểm Set {0}\",\"bettype3914\":\"Sẽ có Set thứ 5 không?\",\"pattern_bet_bettype3915\":\"Đội Dẫn Đầu Sau Mốc {1} Điểm Ở Set {0}\",\"pattern_bet_bettype3916\":\"Đội Dẫn Đầu Sau Mốc {1} Điểm Ở Set {0}\",\"pattern_bet_bettype3917\":\"Tỷ Số Set {0}\",\"moreTab_25\":\"Ghi Trước 15 Điểm\",\"moreTab_26\":\"Điểm\",\"moreTab_27\":\"Set\",\"lbl_VLTitleSet\":\"Set\",\"lbl_VLTitleSetX\":\"Set {0}\",\"lbl_VLPtOU\":\"Tài/Xỉu Điểm\",\"lbl_VLPtHDP\":\"Cược chấp Điểm\",\"lbl_VLTtlPtOU\":\"Tài/Xỉu Tổng Điểm\",\"lbl_VLHWXPts\":\"Thắng cách biệt {0} điểm\",\"lbl_VLAWXPts\":\"Thắng cách biệt {0} điểm\",\"bettype219_tooltip\":\"Điểm Chấp Set\",\"bettype220_tooltip\":\"Tài/Xỉu Tổng Điểm Set\",\"bettype704_tooltip\":\"Cược chấp Điểm Trận đấu\",\"bettype705_tooltip\":\"Tài/Xỉu Điểm Trận đấu\",\"bettype3918_tooltip\":\"Cược đội thắng Set\",\"NumberGameOdd\":\"O\",\"NumberGameEven\":\"E\",\"lbl_TimeRangeTooltip\":\"Nhấn vào đây để chọn khung thời gian ưa thích của bạn！\",\"pattern_bet_bettype3918\":\"Cược đội thắng Set {0}\",\"lbl_VL3913_O\":\"{0} & Tài {1}\",\"lbl_VL3913_U\":\"{0} & Xỉu {1}\",\"lbl_SabaLTWeekly\":\"Hoàn trả Tiền mặt Hàng tuần\",\"lbl_SabaLTUnlock\":\"Mở khóa nhiệm vụ SABA, Nhận đến 1%\",\"lbl_SabaLID\":\"ID SABA\",\"lbl_SabaLPointsBased\":\"Điểm SABA sẽ được thưởng dựa trên tổng tỷ lệ % hoàn trả của \\\"mỗi nhiệm vụ\\\" và phần lợi nhuận âm hoàn lại của \\\"môn thể thao tùy chọn\\\" sẽ được quyết toán.\",\"lbl_SabaLEachPeriod\":\"Mỗi Kỳ\",\"lbl_SabaLBetSpecific\":\"Đặt cược vào \\\"Loại Cược chỉ định của SABA\\\"\",\"lbl_SabaLAllParlay\":\"Tất cả các môn thể thao: Cược xiên\",\"lbl_SabaLSoccerFullTime\":\"Bóng đá: Tỷ số Chính xác Toàn trận & Hiệp một\",\"lbl_SabaLBasketballHDP\":\"Bóng rổ: Cược chấp 1/4 & Tài/ Xỉu 1/4\",\"lbl_SabaLHigherBet\":\"Cược tích lũy càng cao, hoàn trả càng nhiều\",\"lbl_SabaLTO\":\"Doanh thu\",\"lbl_SabaLRebat\":\"Hoàn trả\",\"lbl_SabaLExample\":\"Ví dụ\",\"lbl_SabaLSettleCurrentTask\":\"Quyết toán \\\"Nhiệm vụ Hiện tại\\\"\",\"lbl_SabaLTotalBetamount\":\"Tổng số tiền cá cược của bạn đạt đến {0}; khoản hoàn tiền tương ứng là {1}%\",\"lbl_SabaLSettleRelease\":\"Quyết toán\",\"lbl_SabaLYourSport\":\"Môn thể thao hoàn trả bạn đã chọn là \\\"{0}\\\"\",\"lbl_SabaLCalculationSaba\":\"Phương pháp tính toán phản hồi điểm SABA như sau:\",\"lbl_SabaLMissionRebate\":\"% Hoàn trả Nhiệm vụ\",\"lbl_SabaLNegativeProfit\":\"Lợi nhuận Âm\",\"lbl_SabaLSPs\":\"Điểm SABA\",\"lbl_SabaLPromotionsPage\":\"Đi đến trang khuyến mại\",\"lbl_SabaLForDetail\":\"For betting details, please go to left side of account info\",\"lbl_SabaLInquire\":\"Yêu cầu\",\"lbl_SabaLSeptember\":\"Các chương trình khuyến mãi lớn trong tháng  để tham khảo\",\"lbl_SabaLPremier\":\"Bóng đá - Ngoại hạng Anh, Ligue 1, Serie A, Bundesliga, La Liga\",\"lbl_SabaLBNBA\":\"Bóng rổ - NBA, CBA\",\"lbl_SabaLICCMen\":\"Cricket - ICC Men's T20 World Cup 2022\",\"lbl_SabaLLeagueWorld\":\"Esports - Giải vô địch Thế giới Liên Minh Huyền Thoại\",\"lbl_SabaLSportsOther\":\"Các môn thể thao khác ngoài bóng đá và bóng rổ\",\"lbl_SabaLSpecifiedBetTypes\":\"Loại cược chỉ định của SABA\",\"lbl_SabaLTotalAmount\":\"Tổng số tiền của\",\"lbl_SabaLRebateProgramIn\":\"Chương trình hoàn trả đã tăng lên {0}%\",\"lbl_SabaLCongratulationsRebate\":\"Xin chúc mừng, chương trình hoàn trả đã được tăng lên {0}%！\",\"lbl_SabaLClearance\":\"{0} giờ {1} phút\",\"lbl_SabaLFromStart\":\"{0} ngày {1} giờ\",\"lbl_SabaLComingSoon\":\"Sắp ra mắt…\",\"lbl_SabaLWhatPromotions\":\"Bạn mong chờ chương trình khuyến mãi nào ở SABA?\",\"lbl_SabaLInterstingTask\":\"Nhiệm vụ thú vị\",\"lbl_SabaLNotInterested\":\"Không quan tâm đến nội dung nhiệm vụ\",\"lbl_SabaLCustomizeSport\":\"Môn thể thao hoàn trả có thể tùy chỉnh\",\"lbl_SabaLLowTask\":\"ngưỡng nhiệm vụ thấp\",\"lbl_SabaLRulePromotions\":\"Quy tắc của chương trình khuyến mãi rất dễ hiểu\",\"lbl_SabaLDutyCycle\":\"Chu kỳ nhiệm vụ vừa phải\",\"lbl_SabaLProgramLimitations\":\"Giới hạn chương trình hoàn trả\",\"lbl_SabaLTaskHigh\":\"Ngưỡng nhiệm vụ cao\",\"lbl_SabaLRulesComplicated\":\"Các quy tắc của chương trình khuyến mãi rất phức tạp\",\"lbl_SabaLTaskShort\":\"Thời gian nhiệm vụ quá ngắn\",\"lbl_SabaLNetLoss\":\"Vào chủ nhật lúc 23:59:59 (GMT-4), mỗi khoản hoàn trả tiền mặt cho số tiền lỗ ròng sẽ được tính. Sau khi tính toán, khoản hoàn trả sẽ được giao trong vòng 24 giờ.\",\"lbl_SabaLTypeSoccer_1012\":\"Khi loại hình thể thao là Bóng đá, các thành viên sẽ nhận được khoản hoàn trả tiền mặt 0,2~0,8% cho mỗi 1,00 đô la lỗ ròng trong một vòng cược.\",\"lbl_SabaLTypeBasketball_1012\":\"Khi loại hình thể thao là Bóng rổ, các thành viên sẽ nhận được khoản hoàn trả tiền mặt 0,5~1,1% cho mỗi 1,00 đô la lỗ ròng trong một vòng cược.\",\"lbl_SabaLTypeNot_1012\":\"Khi loại hình thể thao không phải là Bóng đá hoặc Bóng rổ, các thành viên sẽ nhận được khoản hoàn trả tiền mặt 0,5~1,1% cho mỗi 1,00 đô la lỗ ròng trong một vòng cược.\",\"lbl_SabaLStartingSoon\":\"Coming Soon\",\"lbl_SabaLStartsIn\":\"Offer Starts In\",\"lbl_SabaLEndsIn\":\"Settlement Ends In\",\"lbl_99\":\"Môn thể thao khác\",\"lbl_SabaLBetDetails\":\"View rule details\",\"lbl_SabaLMemoAdjust_1012\":\"Remarks: Before 20/11/2022, you can go to the event page to modify the rebate sports.\",\"lbl_SabaLMemo_1012\":\"Giai đoạn thay thế</br>\\n20/11 23:59:59 (GMT-4)\",\"lbl_TotalStakes\":\"Tổng cược\",\"lbl_SabaLExceptSAB\":\"Các môn thể thao khác ngoài bóng đá và bóng rổ\",\"lbl_bettingstatement_Lic\":\"Kết quả cược\",\"lbl_betting_detail\":\"Kết quả cược\",\"lbl_CashOutSettings\":\"Cash Out Settings\",\"lbl_EnableCashOut\":\"Enable Cash Out\",\"lbl_NoCOTktsTooltip\":\"No tickets eligible for Cash Out.\",\"lbl_SabaSurveyTitle\":\"Chia sẻ phản hồi của bạn, nâng cao trải nghiệm của bạn！\",\"lbl_SabaSurveyTitle01\":\"Chia sẻ phản hồi của bạn\",\"lbl_SabaSurveyTitle02\":\"nâng cao trải nghiệm của bạn\",\"lbl_SabaSurveyDes\":\"Phản hồi của bạn rất quan trọng！ <br>Hãy để chúng tôi giúp cải thiện trải nghiệm <strong class=\\\"survey-header__text-strong\\\">đặt cược, sự kiện và hình ảnh</strong> của bạn！\",\"lbl_SabaSurveyEventDescription\":\"Mô tả Sự kiện\",\"lbl_SabaSurveyNotice\":\"Thông báo\",\"lbl_SabaSurveyAccumulation\":\"Vé số tích lũy <strong>{0}</strong>\",\"lbl_SabaSurveyAnswerNow\":\"Trả lời ngay bây giờ để nhận vé số\",\"lbl_SabaSurveyQ01\":\"Bạn có muốn giới thiệu bạn bè cá cược trên Thể thao SABA không?\",\"lbl_SabaSurveyNotRecommend\":\"Không giới thiệu\",\"lbl_SabaSurveyQ02\":\"Bạn có thích thiết kế trực quan của Thể thao SABA không?\",\"lbl_SabaSurveyProblem\":\"Mô tả vấn đề và đề xuất\",\"lbl_SabaSurveyHigherChance\":\"Những người điền biểu mẫu sẽ có cơ hội được rút thăm cao hơn.\",\"lbl_SabaSurveyExample\":\"(Ví dụ: Để kiểm tra trạng thái trò chơi hiện tại, tôi phải quay lại trang cược từ vé Tuyên bố, và tôi mong muốn có một phím tắt để truy cập trận đấu đơn.)\",\"lbl_SabaSurveyAnswer\":\"Vui lòng nhập câu trả lời của bạn\",\"lbl_SabaSurveyCharactersBetween\":\"Giới hạn đầu vào tối đa là 1000 ký tự\",\"lbl_SabaSurveyInfluence\":\"Mức độ nghiêm trọng của vấn đề\",\"lbl_SabaSurveyRequired\":\"Đây là câu hỏi bắt buộc\",\"lbl_SabaSurveyCharactersLess\":\"Nhập ít hơn 10 ký tự\",\"lbl_SabaSurveySubmitWait\":\"Đang gửi, vui lòng đợi\",\"lbl_SabaSurveyLimit\":\"Số phản hồi đã đạt giới hạn\",\"lbl_SabaSurveyThanks\":\"Cảm ơn sự hỗ trợ và phản hồi của bạn\",\"lbl_SabaSurveyReplies\":\"Câu trả lời đã hết hạn\",\"lbl_SabaSurveyQualifying\":\"Chúng tôi đang trong quá trình đánh giá tư cách đủ điều kiện và xổ số, vì vậy hãy nhớ theo dõi！\",\"lbl_SabaSurveyAnnouncement\":\"Thông báo kết quả xổ số\",\"lbl_SabaSurveyHit\":\"Trúng số độc đắc\",\"lbl_SabaSurveyWin\":\"Trúng số\",\"lbl_SabaSurveyTotalBonus\":\"Tổng tiền thưởng\",\"lbl_SabaSurveyYourBonus\":\"Tiền thưởng của bạn\",\"lbl_SabaSurveySheet\":\"Tờ\",\"lbl_SabaSurveyViewNow\":\"Xem ngay\",\"lbl_SabaSurveyBack\":\"Quay lại trang cá cược\",\"lbl_SabaSurveyUnfortunately\":\"Rất tiếc\",\"lbl_SabaSurveyNotWin\":\"Không thắng\",\"lbl_SabaSurveySystemProcessing\":\"Trong quá trình hệ thống xử lý\",\"lbl_SabaSurveyErrorMessage01\":\"Đã có lỗi xảy ra, vui lòng thử lại.\",\"lbl_SabaSurveyErrorMessage02\":\"Đã có lỗi xảy ra trong khi hệ thống đang xử lý\",\"lbl_SabaSurveyLeaveTemporarily\":\"Bạn có muốn rời đi tạm thời không?\",\"lbl_SabaSurveyKeepContent\":\"Chúng tôi sẽ bảo lưu nội dung bạn đã điền, <br>hãy nhớ quay lại điền đầy đủ nhé.\",\"lbl_SabaSurveyLeave\":\"Rời đi\",\"lbl_SabaSurveyMillionDollarLottery\":\"Vé Số Triệu Đô\",\"lbl_SabaSurveyMore\":\"Thêm\",\"lbl_SabaSurveyPays\":\"Thanh toán SABA\",\"lbl_SabaSurveyListen\":\"Lắng nghe Than phiền\",\"lbl_SabaSurveySuggest\":\"Đề xuất nhận vé số, vé số triệu đô đang chờ bạn\",\"lbl_SabaSurveyVIP\":\"Dành riêng cho VIP\",\"lbl_SabaSurveyTryAgain\":\"Vui lòng thử lại\",\"lbl_SabaSurveySubmit01\":\"Đã gửi\",\"lbl_SabaSurveyPutInto\":\"Giải thưởng đã được đưa vào giải độc đắc\",\"lbl_SabaSurveyReplyNow\":\"Trả lời ngay\",\"lbl_SabaSurveyCharactersMore\":\"Nhập hơn 1000 ký tự\",\"lbl_SabaSurveyEventTime\":\"Thời gian sự kiện:\",\"lbl_SabaSurveyEventTime01\":\"Thời gian trả lời bắt đầu từ 12h00 trưa ngày 08/04/2022 (GMT+8) đến 12h00 trưa ngày 18/04/2022 (GMT+8). SABA sẽ tiến hành đánh giá tiêu chí đủ điều kiện và rút thăm giải thưởng sau khoảng thời gian này.\",\"lbl_SabaSurveyEventTime02\":\"SABA sẽ công bố kết quả của lần rút thăm may mắn cho tối đa 50 vé xổ số trên trang sự kiện này vào 12h00 trưa ngày 20/04/2022 (GMT+8). Những người chiến thắng sẽ được chia đều giải thưởng độc đắc.\",\"lbl_SabaSurveyEventTime03\":\"Giải thưởng sẽ được cung cấp đến 12h00 trưa ngày 27/04/2022 (GMT+8). Vui lòng truy cập mục SABA Sports để nhận giải thưởng của bạn trước khi hết hạn.\",\"lbl_SabaSurveyDetail\":\"Chi tiết:\",\"lbl_SabaSurveyDetail01\":\"Khảo Sát Người Dùng SABA dành cho Người Dùng SABA Sports (“Người Dùng”) tùy theo quyền quyết định của SABA trong thời gian diễn ra sự kiện.\",\"lbl_SabaSurveyDetail02\":\"Người dùng sẽ nhận được một (1) vé xổ số cho mỗi lần gửi thành công bảng câu hỏi đã điền đầy đủ của mình. Một Người dùng có thể nhận được tới ba (3) vé xổ số nhờ việc trả lời bảng câu hỏi khảo sát tối đa ba lần.\",\"lbl_SabaSurveyDetail03\":\"Với mỗi khảo sát được gửi thành công mà SABA nhận được từ Người Dùng, giải thưởng độc đắc sẽ được tăng thêm 5 MYR cho giải thưởng độc đắc tối đa là 80.000 MYR (giải thưởng sẽ được quy đổi theo đơn vị tiền tệ của tài khoản của Người Dùng).\",\"lbl_SabaSurveyDetail04\":\"Các nội dung \\\"mô tả vấn đề và đề xuất\\\" được gửi không được lặp lại, nếu không, người tham gia sẽ mất tư cách đủ điều kiện.\",\"lbl_SabaSurveyDetail05\":\"SABA Sports có toàn quyền chấm dứt Khảo sát Người Dùng SABA và thay đổi, giới hạn, sửa đổi hoặc bổ sung các quy tắc, quy định, điều khoản và điều kiện của SABA vào bất kỳ lúc nào mà không cần báo trước.\",\"lbl_SabaSurveyDetail06\":\"SABA Sports có quyền dừng và/hoặc làm vô hiệu các đặc quyền thành viên của Người Dùng đã được cấp, nhận hoặc đổi thưởng giải thưởng bằng lỗi máy tính, bằng cách gian lận hoặc trộm cắp và/hoặc bằng các biện pháp trái phép hoặc theo cách không được cấp phép theo các quy tắc và quy định cũng như các điều khoản và điều kiện của sự kiện Khảo Sát Người Dùng SABA.\",\"lbl_SabaSurveyDetail07\":\"Việc trả lời khảo sát này tương đương với việc Người Dùng đồng ý tuân thủ các điều khoản và điều kiện này. Các quy tắc liên quan đến sự kiện Khảo Sát Người Dùng SABA cũng như các sự kiện đặc biệt khác nhau và mức giảm giá có thể thay đổi mà không báo trước.\",\"lbl_SabaSurveyQuestion1\":\"Trong số các lý do sau, đâu là những lý do khiến quý vị sẵn sàng giới thiệu SABA Sports?\",\"lbl_SabaSurveyMiultiple\":\"Hãy chọn tất cả các đáp án phù hợp\",\"lbl_SabaSurveyChoice01\":\"Danh tiếng thương hiệu tốt\",\"lbl_SabaSurveyChoice02\":\"Trận đấu đa dạng\",\"lbl_SabaSurveyChoice03\":\"Tỷ lệ đặt cược tốt\",\"lbl_SabaSurveyChoice04\":\"Chức năng trang web dễ dàng sử dụng\",\"lbl_SabaSurveyChoice05\":\"Tốc độ trang web nhanh\",\"lbl_SabaSurveyChoice06\":\"Dễ tìm trận đấu\",\"lbl_SabaSurveyChoice07\":\"Trải nghiệm đặt cược tốt\",\"lbl_SabaSurveyChoice08\":\"Chương trình khuyến mãi tốt\",\"lbl_SabaSurveyQuestion2\":\"Trong số các lý do sau, đâu là những lý do khiến quý vị không sẵn sàng giới thiệu SABA Sports?\",\"lbl_SabaSurveyChoice09\":\"Danh tiếng thương hiệu không tốt\",\"lbl_SabaSurveyChoice10\":\"Không có quá nhiều trận đấu\",\"lbl_SabaSurveyChoice11\":\"Tỷ lệ đặt cược không tốt\",\"lbl_SabaSurveyChoice12\":\"Chức năng trang web không dễ dàng sử dụng\",\"lbl_SabaSurveyChoice13\":\"Tốc độ trang web chậm\",\"lbl_SabaSurveyChoice14\":\"Khó tìm trận đấu\",\"lbl_SabaSurveyChoice15\":\"Trải nghiệm đặt cược không tốt\",\"lbl_SabaSurveyChoice16\":\"Chương trình khuyến mãi không tốt\",\"lbl_SabaSurveyRecomend01\":\"Hoàn toàn không sẵn sàng\",\"lbl_SabaSurveyRecomend02\":\"Cực kỳ sẵn sàng\",\"lbl_SabaSurveyPlateform01\":\"Di động\",\"lbl_SabaSurveyPlateform02\":\"Máy tính bàn\",\"lbl_SabaSurveySubmit02\":\"Gửi\",\"lbl_SabaSurveyContinue\":\"Tiếp tục\",\"lbl_SabaSurveyResult\":\"Kết quả\",\"lbl_SabaSurveyCongratulations\":\"Xin chúc mừng\",\"lbl_SabaSurveyFrequency\":\"Gửi quá thường xuyên, vui lòng thử lại sau\",\"lbl_SabaSurvey1min01\":\"Chỉ mất 1 phút để hoàn thành bản câu hỏi, hãy tiến hành điền vào.\",\"lbl_SabaSurvey1min02\":\"SABA mời bạn cho ý kiến phản hồi trong 1 phút để tăng cường trải nghiệm đặt cược của bạn！\",\"lbl_SabaFeedback\":\"Nhận xét\",\"lbl_SoccerClub\":\"Soccer Club\",\"lbl_EsportsPinG\":\"E-Sports PinGoal\",\"lbl_XocDia\":\"Xóc Đĩa\",\"lbl_SabaSel\":\"Casino Royale\",\"sport155\":\"Microgaming\",\"lbl_LicErrorCode_SP-1072\":\"Kính chào Quý khách,<br />Bạn không thể đăng nhập được từ khu vực của bạn.<br />Vui lòng liên hệ bộ phận Chăm Sóc Khách Hàng để biết thêm chi tiết.\",\"lbl_SabaLEndofProgram\":\"Event will be end soon\",\"lbl_LicErrorCode_SP-1074\":\"Có đăng nhập từ nơi khác. Tài khoản đã bị thoát.\",\"lbl_DarkModeTooltip\":\"Trải nghiệm chế độ tối ngay！\",\"lbl_intro_description_1012\":\"14/11/2022 00:00:00 ~ 01/01/2023 23:59:59 (GMT-4)\",\"lbl_WC22inQatar\":\"WORLD CUP 2022 tại QATAR\",\"lbl_SBC1657\":\"Mega Keno\",\"lbl_SportsbookBot\":\"Sportsbook Bot\",\"lbl_SportsbookBot_Tooltip\":\"Liên kết tài khoản của bạn với Telegram để nhận thông tin về World Cup và đặt cược ngay.\",\"lbl_TGErr501Msg\":\"Dịch vụ của chúng tôi hiện đang bảo trì. Vui lòng thử lại sau.\",\"lbl_OBPromotionPeriod\":\"Thời Gian Khuyến Mãi: 17/11/2022 12:00 trưa ~ 19/12/2022 12:00 trưa (GMT+8)\",\"lbl_OBTicket\":\"Bộ Cường Hóa Tỷ Lệ Cược\",\"lbl_OBAvailableAmounts\":\"Số tiền có sẵn\",\"lbl_OBTimeCountDown\":\"Thời gian còn lại:\",\"lbl_OBTicketCount\":\"Số bộ cường hóa tỷ lệ cược kiếm được cho giai đoạn tiếp theo {0}\",\"lbl_OBSettleTime\":\"Kết thúc trong vòng {0} giờ. Bộ cường hóa tỷ lệ cược sẽ được phân phối vào lúc 12:10 trưa ngày hôm sau. (GMT+8)\",\"lbl_OBAccumlatedStake\":\"Tiền cược cộng dồn\",\"lbl_OBAccumlatedBetCount\":\"Tổng cược cộng dồn\",\"lbl_OBWaytoGet\":\"Cách để có được\",\"lbl_OBDesignatedSports\":\"Môn thể thao được chỉ định\",\"lbl_OBDesignatedBetType\":\"Loại cược được chỉ định\",\"lbl_OBAllBetTypesE\":\"Tất cả các loại cược (Không bao gồm: Cược xiên và Rút tiền)\",\"lbl_OBWayToAccumlate\":\"Cách tích lũy\",\"lbl_OBConditions\":\"Điều kiện yêu cầu\",\"lbl_OBStake\":\"Tiền đặt cược\",\"lbl_OBBetCount\":\"Tổng cược\",\"lbl_OBReward\":\"Tiền thưởng\",\"lbl_OBSummarySaba\":\"Tóm tắt: SABA Sports sẽ cung cấp tỷ lệ cược tốt nhất trên toàn thị trường.\",\"lbl_OBGiveawayTime\":\"Thời gian phát thưởng\",\"lbl_OBNextDay\":\"12:10 trưa ngày hôm sau (GMT+8)\",\"lbl_OBWayToUse\":\"Cách sử dụng\",\"lbl_OBSportsSupported\":\"Các môn thể thao được hỗ trợ\",\"lbl_OBWCExclusive\":\"Độc quyền World Cup 2022\",\"lbl_OBBetTypeSupported\":\"Loại cược được hỗ trợ\",\"lbl_OBFHHandicap\":\"Cược chấp Cả Trận/Hiệp 1\",\"lbl_OBFHOverUnder\":\"Tài/Xỉu Cả Trận/Hiệp 1\",\"lbl_OBExpireDate\":\"Ngày hết hạn\",\"lbl_OBGiveNextDay\":\"12:10 trưa vào ngày phát thưởng ~ 12:00 trưa ngày hôm sau (GMT+8)\",\"lbl_OBRestructions\":\"Hạn chế\",\"lbl_OBOneBoosterPerBet\":\"Một bộ cường hóa tỷ lệ cược cho mỗi lần cược\",\"lbl_OBTermsandConditions\":\"Điều khoản và điều kiện\",\"lbl_OBRReject\":\"Nếu chương trình tăng tỷ lệ cược bị hủy bỏ vì bất kỳ lý do nào, SABA Sports có quyền sửa đổi và đưa ra quyết định cuối cùng về sự kiện này.\",\"lbl_OBCongratulations\":\"Xin chúc mừng\",\"lbl_OBCheckDetails\":\"Kiểm tra chi tiết\",\"lbl_OBWCBanner\":\"FIFA World Cup 2022\\n Xin giới thiệu bộ cường hóa tỷ lệ cược SABA Sports！\",\"lbl_BetNow\":\"Cược Ngay\",\"lbl_OBNoneOBTicket\":\"Hiện tại không có Bộ Cường Hóa Tỷ Lệ Cược nào\",\"lbl_OBAchieveTask\":\"Bộ cường hóa tỷ lệ cược sẽ được trao sau khi hoàn thành các nhiệm vụ sau đây\",\"lbl_OBOverTicket\":\"Bộ Cường Hóa Tỷ Lệ Cược đã được gửi\",\"lbl_OBFinishTicket\":\"Tất cả các nhiệm vụ đã được hoàn thành\",\"lbl_OBUsedTicket\":\"Đã sử dụng\",\"lbl_SabaSurveyRules\":\"Quy định\",\"lbl_EditNickname\":\"Chỉnh sửa biệt danh\",\"lbl_TipStreamer\":\"Tặng quà cho Streamer\",\"lbl_EnterNickname\":\"Nhập nickname của bạn\",\"lbl_StreamerSend\":\"Tặng\",\"lbl_StreamerSendSucs\":\"Tặng quà thành công\",\"lbl_StreamerGift1\":\"Tim\",\"lbl_StreamerGift2\":\"Cái hôn\",\"lbl_StreamerGift3\":\"Hoa\",\"lbl_StreamerGift4\":\"Siêu xe\",\"lbl_StreamerGift5\":\"Lâu dài\",\"lbl_EnterNicknameTooltip\":\"Vui lòng nhập nickname của bạn\",\"lbl_StreamerInsfcntFundMsg\":\"Không đủ số dư. Vui lòng nạp tiền trước.\",\"lbl_StreamerSysErrorMsg\":\"Hệ thống lỗi. Vui lòng thử lại sau. {0}\",\"lbl_StreamerTipsIntro\":\"Tính năng mới！ Ủng hộ Streamer yêu thích của bạn bằng cách gửi những món quà đặc biệt\",\"lbl_StreamerTips\":\"Phần thưởng Streamer\",\"lbl_Tips\":\"Phần thưởng\",\"lbl_PlayerTips\":\"Phần thưởng Người chơi\",\"lbl_TipsinprogressMsg\":\"Phần thưởng đang được xử lý, vui lòng kiểm tra lại sao kê sau\",\"supportzalo\":\"Zalo\",\"lbl_SysSettlingTicketMsg\":\"Tất cả vé cược đang được kết toán. Vui lòng quay lại kiểm tra sau.\",\"lbl_CricketLottery\":\"Xổ số Cricket\",\"lbl_Soccer5_A\":\"A\",\"lbl_Soccer5_H\":\"H\",\"lbl_Soccer5_1st\":\"Thứ 1\",\"lbl_Soccer5_2nd\":\"Thứ 2\",\"lbl_Soccer5_3rd\":\"Thứ 3\",\"lbl_Soccer5_4th\":\"Thứ 4\",\"lbl_SabaPinG_All\":\"All PinGoal\",\"lbl_SabaLThreeStage_1013\":\"Thời gian khuyến mãi của chương trình SABA sẽ có hiệu lực trong 4 giai đoạn. Thời gian sự kiện: Từ ngày 09/01/2023, 00:00:00 đến ngày 05/02/2023, 23:59:59 (GMT-4). Hạn chót quy đổi: Ngày 02/12/2023, 23:59:59 (GMT-4).\",\"lbl_intro_description_1013\":\"02/01/2023 00:00:00 ~ 12/02/2023 23:59:59 (GMT-4)\",\"lbl_SabaLMemo_1013\":\"Giai đoạn thay thế</br>\\n08/01 23:59:59 (GMT-4)\",\"lbl_SabaLMemoAdjust_1013\":\"Remarks: Before 2023/01/08, you can go to the event page to modify the rebate sports.\",\"lbl_SabaLEventTime2_1013\":\"09/01/2023 ~ 05/02/2023 SABA Sports sẽ hoàn tiền cho môn thể thao bạn chọn, khoản lỗ ròng của môn thể thao bạn chọn sẽ được tính riêng và hoàn lại dưới dạng lợi nhuận âm.\",\"lbl_SabaLTypeSoccer_1013\":\"Khi loại hình thể thao là Bóng đá, các thành viên sẽ nhận được khoản hoàn trả tiền mặt 0,4~0,8% cho mỗi 1,00 đô la lỗ ròng trong một vòng cược.\",\"lbl_SabaLTypeBasketball_1013\":\"Khi loại hình thể thao là Bóng rổ, các thành viên sẽ nhận được khoản hoàn trả tiền mặt 0,7~1,1% cho mỗi 1,00 đô la lỗ ròng trong một vòng cược.\",\"lbl_SabaLTypeNot_1013\":\"Khi loại hình thể thao không phải là Bóng đá hoặc Bóng rổ, các thành viên sẽ nhận được khoản hoàn trả tiền mặt 0,7~1,1% cho mỗi 1,00 đô la lỗ ròng trong một vòng cược.\",\"lbl_PBTicketsOnly\":\"Phone Betting Tickets Only\",\"lbl_BacktoEvent\":\"Quay lại Sự Kiện \",\"lbl_PB_AddTktDelTktMsg\":\"When you place this bet, <div class=\\\"c-text-accent\\\">Ref No.{0} </div>will be deleted at the same time.\",\"lbl_PB_MatchClosedUnableBetMsg\":\"Unable to place this bet because this match is closed.\",\"lbl_PB_AddTktFailDelMsg\":\"Bet successfully but FAILED to delete Ref no. {0} . Please delete this ticket manually.\",\"lbl_MyLeagues\":\"Các Giải đấu của tôi\",\"lbl_MyLeagueNo\":\"Các Giải đấu của tôi {0}\",\"lbl_Add\":\"Thêm\",\"lbl_Modify\":\"Sửa đổi\",\"lbl_CreateList\":\"Tạo Danh sách\",\"lbl_SaveList\":\"Save List\",\"lbl_ModifyList\":\"Modify My League\",\"lbl_CreateListTittle\":\"Tạo Danh sách Giải đấu của riêng bạn\",\"lbl_CreateListInfo\":\"Bấm “Tạo Danh sách” để theo dõi các giải đấu yêu thích của bạn\",\"lbl_AddLeague\":\"Thêm vào Giải đấu của tôi\",\"lbl_MyLeagueFull\":\"Danh sách giải đấu đã đầy. (tối đa {0} giải đấu)\",\"lbl_LoadMyLeagueFail\":\"Load my league list failed. Please visit other events and try later.\",\"lbl_LoadListFail\":\"Không thể tải danh sách giải đấu của tôi.\",\"lbl_CreateListFail\":\"Create my league list failed.\",\"lbl_ModifyListFail\":\"Modify my league list failed.\",\"lbl_International\":\"quốc tế\",\"lbl_EliteEuro\":\"Elite Euro\",\"lbl_UK\":\"UK\",\"lbl_Asia\":\"Asia\",\"lbl_UEFA\":\"UEFA\",\"lbl_Americas\":\"Americas\",\"esport_gametype_98\":\"E-Sports PinGoal\",\"lbl_PB_EditTktTooltip\":\"Edit new ticket\",\"lbl_SabaLThreeStage_1014\":\"Thời gian khuyến mãi của chương trình SABA sẽ có hiệu lực trong 6 giai đoạn. Thời gian sự kiện: Từ ngày 27/02/2023, 00:00:00 đến ngày 09/04/2023, 23:59:59 (GMT-4). Hạn chót quy đổi: Ngày 16/04/2023, 23:59:59 (GMT-4).\",\"lbl_intro_description_1014\":\"27/02/2023 00:00:00 ~ 16/04/2023 23:59:59 (GMT-4)\",\"lbl_SabaLMemo_1014\":\"Giai đoạn thay thế</br>\\n26/02 23:59:59 (GMT-4)\",\"lbl_SabaLMemoAdjust_1014\":\"Remarks: Before 2023/02/26, you can go to the event page to modify the rebate sports.\",\"lbl_SabaLEventTime2_1014\":\"27/02/2023 ~ 09/04/2023 SABA Sports sẽ hoàn tiền cho môn thể thao bạn chọn, khoản lỗ ròng của môn thể thao bạn chọn sẽ được tính riêng và hoàn lại dưới dạng lợi nhuận âm.\",\"lbl_SabaLTypeSoccer_1014\":\"Khi loại hình thể thao là Bóng đá, các thành viên sẽ nhận được khoản hoàn trả tiền mặt 0,4~0,8% cho mỗi 1,00 đô la lỗ ròng trong một vòng cược.\",\"lbl_SabaLTypeBasketball_1014\":\"Khi loại hình thể thao là Bóng rổ, các thành viên sẽ nhận được khoản hoàn trả tiền mặt 0,7~1,1% cho mỗi 1,00 đô la lỗ ròng trong một vòng cược.\",\"lbl_SabaLTypeNot_1014\":\"Khi loại hình thể thao không phải là Bóng đá hoặc Bóng rổ, các thành viên sẽ nhận được khoản hoàn trả tiền mặt 0,7~1,1% cho mỗi 1,00 đô la lỗ ròng trong một vòng cược.\",\"lbl_RemoveAll\":\"Xóa tất cả\",\"lbl_AddFavTeamTooltip\":\"Thêm đội tuyển vào Yêu Thích của Tôi\",\"lbl_AddFavTeamTitle\":\"Thêm vào Yêu Thích của Tôi\",\"lbl_RemoveFavTeam\":\"Nhấp vào tên nhóm để hủy theo dõi nhóm ngay lập tức\",\"lbl_PB_WrongOddsMsg\":\"Không thể đặt cược này. Vui lòng kiểm tra loại tỷ lệ cược của bạn.\",\"lbl_MatchFilter\":\"Bộ Lọc Trận Đấu\",\"lbl_MatcFilter_Tooltip\":\"Bộ Lọc Tr