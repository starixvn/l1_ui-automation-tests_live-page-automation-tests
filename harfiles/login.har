            "text": "html {\r\n    height: 100%;\r\n}\r\nbody {\r\n    height: 100%;\r\n    padding: 0;\r\n    margin: 0;\r\n}\r\nbody > form {\r\n    height: 100%;\r\n}\r\n.mini-game {\r\n    width: 224px;\r\n    height: 100%;\r\n    /* border: 1px solid #162032; */\r\n    font-family: Arial, '?????';\r\n    box-sizing: border-box;\r\n}\r\n.mini-game .mini-game-content {\r\n    min-height: calc( 100% - 15px);\r\n    padding: 5px 10px;\r\n    background: url(images/mini/mini_bg.png);\r\n    background-size: cover;\r\n    border-top: 2px solid #6892cc;\r\n    border-bottom: 3px solid #6892cc;\r\n    position: relative;\r\n}\r\n[data-darkmode='true'] .mini-game .mini-game-content {\r\n    background-image: linear-gradient(to right, #2e426b, #1f2c47);\r\n    border-top: 2px solid #1f2c47;\r\n    border-bottom: 3px solid #1f2c47;\r\n}\r\n.mini-game .mini-game-content .mini-bg {\r\n    width: 123px;\r\n    height: 86px;\r\n    position: absolute;\r\n    bottom: 0;\r\n    left: 0;\r\n}\r\n.mini-game-list {\r\n    z-index: 1;\r\n    position: relative;\r\n}\r\n.mini-game-list p.enable {\r\n    color: #1d283e;\r\n    font-size: 12px;\r\n}\r\n[data-darkmode='true'] .mini-game-list p.enable {\r\n    color: #fff;\r\n}\r\n.mini-game-list .mini-game-single {\r\n    width: 33.3%;\r\n    margin-top: 6px; \r\n    float: left;\r\n    text-align: center;\r\n    vertical-align: top;\r\n    cursor: pointer;\r\n    position: relative;\r\n}\r\n.mini-game-list .mini-game-single:hover {}\r\n    .mini-game-list .mini-game-single:after {\r\n        content: url(images/mini/game-mask.png);\r\n        position: absolute;\r\n        z-index: 1;\r\n        top: 0;\r\n        left: 8px;\r\n        width: 52px;\r\n        height: 52px;\r\n        border-radius: 10px;\r\n        display: none;\r\n    }\r\n.mini-game-list .mini-game-single:hover:after {\r\n    display: block;\r\n}\r\n.mini-game-list .mini-game-single p {\r\n    color: #192131;\r\n    font-weight: bold;\r\n    text-align: center;\r\n    font-size: 12px;\r\n    line-height: 12px;\r\n    margin: 0;\r\n    height: 24px;\r\n    overflow: hidden;\r\n}\r\n[data-darkmode='true'] .mini-game-list .mini-game-single p {\r\n    color: #fff;\r\n} \r\n\r\n.mini-game-list .mini-game-single.unfinished:before {\r\n    content: url(images/mini/Unfinished_icon.png);\r\n    display: block;\r\n    position: absolute;\r\n    z-index: 2;\r\n    top: 0;\r\n    left: 8px;\r\n}\r\n.mini-game-list .mini-game-single.soon {\r\n    cursor: not-allowed;\r\n}\r\n.mini-game-list .mini-game-single.soon p {\r\n    opacity: .5;\r\n}\r\n.mini-game-list .mini-game-single.soon:before {\r\n    content: url(images/mini/Soon_icon.png);\r\n    display: block;\r\n    position: absolute;\r\n    z-index: 2;\r\n    top: 0;\r\n    left: 9px;\r\n}\r\n\r\n.mini-game-list .mini-game-single.new:before {\r\n    content: url(images/mini/new_icon.png);\r\n    display: block;\r\n    position: absolute;\r\n    z-index: 5;\r\n    top: 0;\r\n    right: 8px;\r\n}\r\n\r\n.gameicon {\r\n  width: 50px;\r\n  height: 50px;\r\n  border-radius: 3px;\r\n  overflow: hidden;\r\n  box-shadow: 0px 1px 2px 0px rgba(0, 0, 0, 0.5);\r\n}\r\n\r\n.clearfix {\r\n    clear: both;\r\n    display: block;\r\n}\r\n\r\n.mini-mask{\r\n    width:100%;\r\n    height:100%;\r\n    left:0;\r\n    top:0;\r\n    display:none;\r\n    background-color:#fff;\r\n    z-index:1000;\r\n}\r\n\r\n.mini-game.unGame .mini-game-content {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n}\r\n.mini-game.unGame .mini-game-list p.enable {\r\n    margin: 1px;\r\n    text-align: center;\r\n}\r\n\r\n/*refresh page*/\r\n.mini-game-list p.refresh {\r\n    color: #2e426b;\r\n    font-size: 14px;\r\n    text-align: center;\r\n}\r\n[data-darkmode='true'] .mini-game-list p.refresh {\r\n    color: #fff;\r\n}\r\n.icon-refresh {\r\n    width: 20px;\r\n    height: 20px;\r\n    background: url(images/mini/icon-refresh.png);\r\n    position: absolute;\r\n    top: 1px;\r\n    left: 1px;\r\n}\r\n.btn-refresh {\r\n    width: 24px;\r\n    height: 24px;\r\n    margin: 0 auto;\r\n    background: #2279f1;\r\n    transition: .3s;\r\n    border-radius: 50%;\r\n    position: relative;\r\n    cursor: pointer;\r\n}\r\n.mini-game-content:hover .btn-refresh {\r\n    background: #0c60d6;\r\n}\r\n.btn-refresh.rotate {\r\n    transition: .3s;\r\n    animation: rotate 1.0s infinite linear;\r\n}\r\n@-webkit-keyframes rotate {\r\n    100% {-webkit-transform: rotate(360deg);}\r\n}\r\n@keyframes rotate {\r\n    100% {\r\n        transform: rotate(360deg);\r\n        -webkit-transform: rotate(360deg);\r\n    }\r\n}\r\n\r\n/*UM Page*/\r\n.mini-game.um-page {\r\n    min-height: 187px;\r\n}\r\n\r\n    .mini-game.um-page .mini-game-content {\r\n        height: 100%;\r\n        box-sizing: border-box;\r\n        display: -webkit-flex;\r\n        display: -ms-flexbox;\r\n        display: flex;\r\n        -webkit-justify-content: center;\r\n        -ms-flex-pack: center;\r\n        justify-content: center;\r\n        -webkit-align-items: center;\r\n        -ms-flex-align: center;\r\n        align-items: center;\r\n    }\r\n\r\n    .mini-game.um-page .mini-game-list {\r\n        width: 100%;\r\n        text-align: center;\r\n    }\r\n\r\n        .mini-game.um-page .mini-game-list h1 {\r\n            margin: 5px 0;\r\n            color: #ff0000;\r\n            font-size: 14px;\r\n            font-weight: bold;\r\n        }\r\n\r\n        .mini-game.um-page .mini-game-list p {\r\n            margin: 0;\r\n            color: #192131;\r\n            font-size: 12px;\r\n            line-height: 15px;\r\n            font-weight: normal;\r\n        }\r\n        [data-darkmode='true'] .mini-game.um-page .mini-game-list p {\r\n            color:#fff\r\n        }\r\n        .mini-game.um-page .mini-game-list span.hint {\r\n            color: #ffff00;\r\n        }"
          },
